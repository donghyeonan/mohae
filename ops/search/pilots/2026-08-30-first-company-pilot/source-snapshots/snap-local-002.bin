		<main> 		 	 			 		<div doz_type="inside" class="inside"><div doz_type="row" doz_xdz="12" class="doz_row  col-xdz col-xdz-12"><div doz_type="grid" doz_xdz="12" class="col-dz col-dz-  col-xdz col-xdz-12"><div doz_type="widget" id="w20260726e8b791d8be6f8"><div class="_widget_data " data-widget-name="이미지" data-widget-type="image" data-widget-anim="none" data-widget-anim-duration="0.7" data-widget-anim-delay="0" data-widget-parent-is-mobile="Y"><div class="widget image  _image_wrap text_position_bottom hover_text_position_bottom visibility org_size  hover_img_hide   same_overlay">
