	}
	.scroll-to-fixed-fixed .mobile_carousel_nav .nav-item > a,
	.scroll-to-fixed-fixed .mobile_carousel_nav .nav-item.use_sub_name:hover>a>.plain_name:before {
		color: #686868;
	}
