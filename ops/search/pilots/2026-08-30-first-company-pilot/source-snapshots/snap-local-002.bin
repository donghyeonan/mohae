	.admin #w20260726e8b791d8be6f8 .widget.image img {
		transition: none;
	}

	.admin #w20260726e8b791d8be6f8 .disable-selection img {
		visibility: visible !important;
	}
	#w20260726e8b791d8be6f8 .widget.image .overlay, #w20260726e8b791d8be6f8 .widget.image .hover_overlay {
		background: #00000000;
		transition: opacity .3s, background-color .3s;
	}
	#w20260726e8b791d8be6f8 .widget.image:hover .hover_overlay {
		background: #00000000;
		z-index: 6;
		opacity: 1;
	}
	.admin #w20260726e8b791d8be6f8 .widget.image:hover .hover_overlay,
	#w20260726e8b791d8be6f8 .widget.image.hover_image_hidden:hover .hover_overlay {
		opacity: 0 !important;
	}
	#w20260726e8b791d8be6f8 .widget.image.text_position_overlay .txt .txt_body {
		color: ;
		;
		line-height: 1.2;
		padding: 1em;
	}
	#w20260726e8b791d8be6f8 .widget.image.hover_text_position_overlay:hover .hover_txt .txt_body {
		color: ;
		;
		padding: 1em;
	}
	#w20260726e8b791d8be6f8 .widget.image.hover_text_position_overlay:hover .hover_txt .txt_body {
		line-height: 1.2;
	}
	#w20260726e8b791d8be6f8 .widget.image.img_circle .overlay,
	#w20260726e8b791d8be6f8 .widget.image.img_circle .hover_overlay {
		border-radius: 50%;
	}
	#w20260726e8b791d8be6f8 .widget.image.hover_scale:hover .hover_overlay,
	#w20260726e8b791d8be6f8 .widget.image.same_overlay:hover .overlay {
		transform: scale(1.1);
		transition: opacity .3s;
	}
	#w20260726e8b791d8be6f8 .widget.image.hide_default_img:hover .img_wrap > img,
	#w20260726e8b791d8be6f8 .widget.image:hover .overlay,
	#w20260726e8b791d8be6f8 .widget.image .hover_overlay,
	#w20260726e8b791d8be6f8 .widget.image.hover_image_hidden:hover .hover_img,
	#w20260726e8b791d8be6f8 .widget.image.hover_scale .hover_img,
	#w20260726e8b791d8be6f8 .widget.image.hover_scale.hover_image_hidden:hover .hover_img {
		opacity: 0;
	}
	#w20260726e8b791d8be6f8 .widget.image.hide_default_img:hover .img_wrap > img{
		opacity: 0 !important;

	}
	#w20260726e8b791d8be6f8 .widget.image.hover_scale img {
		transition: transform 0.4s ease-out;
	}
	#w20260726e8b791d8be6f8 .widget.image.hover_scale img,
	#w20260726e8b791d8be6f8 .widget.image.hover_scale:hover .hover_img,
