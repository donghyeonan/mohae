			<!-- //보도자료 다운로드 -->
			
			<ul class="floating-footnote" style="display: none;">
			</ul>

			<script>
				const footnoteList = document.querySelector('.floating-footnote');
				const footnotes = document.querySelectorAll('.has-footnote');
				const makeFootnoteList = () => {
					let itemIndex = 1;
					if (footnotes.length > 0) {
						footnotes.forEach(item => {
							let s = '<li><div class="footnote-item" data-list-index="' + itemIndex + '" data-text-visible="false"><strong class="keyword">';
							s = s  + item.innerHTML;
							s = s  + '</strong><div class="text">';
							s = s  + item.nextSibling.innerHTML;
							s = s  + '</div></div></li>';
							footnoteList.insertAdjacentHTML("beforeend", s);
							item.setAttribute('data-item-index', itemIndex);
							item.nextSibling.remove();
							itemIndex++;
						});
						activeFootnote();
						window.addEventListener('resize', () => {
							footnoteList.querySelectorAll('.footnote-item').forEach(el => {
								el.parentNode.className = '';
								el.setAttribute('data-text-visible', 'false');
							});
						});
					}
					footnoteList.style.display = 'flex';
				};
				const activeFootnote = () => {
					const clickVisible = () => {
						footnotes.forEach(item => {
							const targetItem = footnoteList.querySelector('div[data-list-index="' + item.dataset.itemIndex + '"]');
							item.addEventListener('click', event => {
								if (targetItem.getAttribute('data-text-visible') === 'false') {
									let clickLeft = 0;
									if (event.clientX < 40) {
										clickLeft = 40;
									} else if (event.clientX > window.innerWidth - 40) {
										clickLeft = window.innerWidth - 40;
									} else {
										clickLeft = event.clientX;
									}
									targetItem.parentNode.classList.add('click-show');
									targetItem.style.top = item.getBoundingClientRect().top + 'px';
									targetItem.style.left = clickLeft + 'px';
									if (clickLeft < 152) {
										targetItem.querySelector('.text').style.transform = 'translateX(' + ( 152 - clickLeft ) + 'px)';
									} else if ((window.innerWidth - clickLeft) < 152 ) {
										targetItem.querySelector('.text').style.transform = 'translateX(' + (window.innerWidth - (clickLeft +  152)) + 'px)';
									} else {
										targetItem.querySelector('.text').style.transform = 'none';
									}
									targetItem.setAttribute('data-text-visible', 'true');
								} else {
									targetItem.parentNode.classList.remove('click-show');
									targetItem.style.top = 'auto';
									targetItem.style.left = 'auto';
									targetItem.setAttribute('data-text-visible', 'false');
								}
							});
							targetItem.parentNode.addEventListener('click', event => {
								if (event.target.tagName === 'LI') {
									targetItem.parentNode.classList.remove('click-show');
									targetItem.style.top = 'auto';
									targetItem.style.left = 'auto';
									targetItem.setAttribute('data-text-visible', 'false');
								}
							});
							window.addEventListener('scroll', () => {
								targetItem.parentNode.classList.remove('click-show');
								targetItem.style.top = 'auto';
								targetItem.style.left = 'auto';
								targetItem.setAttribute('data-text-visible', 'false');
							});
						});
					}
					footnoteList.querySelectorAll('.footnote-item').forEach(el => {
						el.parentNode.className = '';
						el.setAttribute('data-text-visible', 'false');
					});

					clickVisible();
				};
				makeFootnoteList();
			</script>
		</div>
