</div></div><div class="flex items-center gap-2 text-[14px]"><a id="contact" class="transition hover:text-[#0A0A0A]" href="mailto:support@fypro.ai">Contact</a></div></div></div></footer></div></div></main><!--$--><!--/$--><script src="https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0nw6g-a69vgfp.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n7:I[68027,[\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0vsj8w6t~jcsd.js\",\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\",1]\n:HL[\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0pf~renzgtt99.css\",\"style\"]\n:HL[\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/media/GoogleSansFlex_24pt_Medium-s.p.0crvzn60dq448.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/media/GoogleSansFlex_24pt_Regular-s.p.0r2x.wu1sondv.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/media/GoogleSansFlex_24pt_SemiBold-s.p.0hviar0r5p45i.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/media/e41d5df559864f9e-s.p.0gq7fw9.sy_5..woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n2:T988,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"@id\":\"https://www.fypro.ai/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does Fypro actually do for me?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Fypro is an AI growth engine for creators. Drop your handle and it builds a personalized plan for what to post and what to sell — then helps you run it across your site, products, content, and customer list. Fypro can analyze your TikTok account, generate content ideas and scripts, prepare videos, and let creators review and approve posts before publishing.\"}},{\"@type\":\"Question\",\"name\":\"How is this different from a link-in-bio tool or a generic storefront builder?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Those tools each solve a slice — a link page, a template store, a checkout. Fypro builds the plan, then runs each part of the workflow for you, end to end. Plus, every customer you sell to becomes your customer — emails, purchase history, repeat-buyer signals, all yours.\"}},{\"@type\":\"Question\",\"name\":\"How is this different from content-only AI tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Content tools give you hooks. Fypro gives you the playbook — what to post, what to sell, and how to grow — and then runs the monetization side too. We start where they stop.\"}},{\"@type\":\"Question\",\"name\":\"Do I have to leave TikTok or change my content?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Keep posting where you post. Fypro reads your account, then builds the layer underneath that turns your audience into income — your site, your products, your customer list. Your social account is your front door. Fypro is the engine room behind it.\"}},{\"@type\":\"Question\",\"name\":\"Is the Free plan really free forever?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. No credit card. No time limit. Your first strategy is on us.\"}},{\"@type\":\"Question\",\"name\":\"Do I need editing or design skills to use it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you can post a TikTok, you can use Fypro.\"}},{\"@type\":\"Question\",\"name\":\"How do you handle my data and my customers' data?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your customer list belongs to you — emails, purchase history, everything. Encrypted, never sold, exportable in one click. Yours to keep if you ever leave.\"}},{\"@type\":\"Question\",\"name\":\"Can I cancel anytime?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Anytime. No questions, no fees.\"}}]}"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"c\":[\"\",\"\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"__PAGE__\",{}]},\"$undefined\",\"$undefined\",16],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0pf~renzgtt99.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0vsj8w6t~jcsd.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"https://assets-cdn.fypro.com/web/ai-chat/v_20260827_154503318/_next/static/chunks/0d3shmwh5_nmn.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"googlesansflex_3d06eb87-module__dbfbZq__variable instrument_serif_2c398422-module__pOELkq__variable h-full antialiased\",\"children\":[[\"$\",\"head\",null,{\"children\":[[[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://assets-cdn.fypro.com\",\"crossOrigin\":\"anonymous\"}],null,[[\"$\",\"link\",\"https://www.googletagmanager.com\",{\"rel\":\"dns-prefetch\",\"href\":\"https://www.googletagmanager.com\"}],[\"$\",\"link\",\"https://mc.yandex.ru\",{\"rel\":\"dns-prefetch\",\"href\":\"https://mc.yandex.ru\"}],[\"$\",\"link\",\"https://analytics.tiktok.com\",{\"rel\":\"dns-prefetch\",\"href\":\"https://analytics.tiktok.com\"}],[\"$\",\"link\",\"https://connect.facebook.net\",{\"rel\":\"dns-prefetch\",\"href\":\"https://connect.facebook.net\"}]]],[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{