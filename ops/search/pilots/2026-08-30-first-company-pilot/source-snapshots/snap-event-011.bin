    <body class="custom_scrollbars">
      <script>
        (function() {
    var DARK_SUPPORTED_UA_BROWSER_CODE = 1000
    var NAVER_APP_BROWSER_CODE_REGEXP = /naver\((\S+);\s(\S+);\s(\S+);\s(\S+)(?:;\s(\S+))?\)/
    var DARK_THEME_PATHS_REGEXP = /\/(booking\/\d+|coupon\/promotions\/|my\/|order\/|review\/|parcel-delivery\/).*/
    var WEBVIEW_SDK_DARK_MODE_REGEXP = /webviewsdk\([^;]+;\s*dark[;)]/

    var userAgent = window.navigator.userAgent.toLowerCase()

    var isNaverApp = userAgent.indexOf('naver') !== -1

    var naverAppBrowserCodeResult = userAgent.match(NAVER_APP_BROWSER_CODE_REGEXP)
    var naverAppBrowserCode = naverAppBrowserCodeResult && naverAppBrowserCodeResult[3]
    var naverAppType = naverAppBrowserCodeResult && naverAppBrowserCodeResult[2]
    var isNaverMapApp = naverAppType === 'map'
    var isDarkModeFromWebViewSDK = WEBVIEW_SDK_DARK_MODE_REGEXP.test(userAgent)
    var darkModeMediaQueryList = window.matchMedia('(prefers-color-scheme: dark)')

    var isMapPC = window.location.search.indexOf('map-pc') !== -1
    var isDarkThemeApplicable = false && DARK_THEME_PATHS_REGEXP.test(window.location.pathname)

    // #77650 iframe 환경에서 부모로부터 다크모드 상태를 URL 파라미터로 전달받음
    var urlParams = new URLSearchParams(window.location.search)
    var colorSchemeParam = urlParams.get('colorScheme')
    var isDarkModeFromParam = colorSchemeParam === 'dark'

    function isDarkmodeAvailable() {
      // URL 파라미터로 다크모드가 명시적으로 전달된 경우 우선 적용
      if (isDarkModeFromParam) {
        return !isMapPC
      }

      // WebViewSDK UA에서 dark 모드가 명시된 경우 (예: WebViewSDK(map; dark; portrait))
      if (isDarkModeFromWebViewSDK) {
        return !isMapPC
      }

      return (
        !isMapPC &&
        darkModeMediaQueryList &&
        darkModeMediaQueryList.matches &&
        (isNaverApp ? (!isNaverMapApp && Number(naverAppBrowserCode) >= DARK_SUPPORTED_UA_BROWSER_CODE) : isDarkThemeApplicable)
      )
    }

    if (isDarkmodeAvailable()) {
      document.body.classList.add('pui__apply_darkmode')
    }

    function handleColorSchemeMediaQueryChange(event) {
      var classList = window.document.body.classList

      if (event.matches && !classList.contains('pui__apply_darkmode') && isDarkmodeAvailable()) {
        classList.add('pui__apply_darkmode')
      } else if (!event.matches && classList.contains('pui__apply_darkmode') && !isDarkModeFromParam && !isDarkModeFromWebViewSDK) {
        // colorScheme=dark 파라미터 또는 WebViewSDK dark 모드가 있으면 시스템 설정 변경과 관계없이 다크모드 유지
        classList.remove('pui__apply_darkmode')
      }
    }

    var mediaQueryList = window.matchMedia('(prefers-color-scheme: dark)')

    // addEventListener is not supported in IOS13, IE11
    if (mediaQueryList.addEventListener) {
      mediaQueryList.addEventListener('change', handleColorSchemeMediaQueryChange)
    } else {
      mediaQueryList.addListener(handleColorSchemeMediaQueryChange)
    }
  })()
      </script>
