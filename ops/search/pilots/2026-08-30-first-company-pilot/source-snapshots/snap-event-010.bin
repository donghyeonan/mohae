  <script>window.__APOLLO_STATE__={"Business:1696844":{"__typename":"Business","id":"1696844","brandId":null,"businessId":"1696844","membershipCode":null,"placeId":"2020855313","impPlaceId":"2020855313","placeRootCategoryId":null,"name":"(주) 아모레퍼시픽","rawNames":{"__typename":"RawNames","name":"(주) 아모레퍼시픽","serviceName":"STORY A 성수 : 뷰티서바이벌 살인사건"},"reprOwnerName":"김승환","bookingTerm":"예약","bizNumber":"1068643373","businessTypeId":12,"businessGroupId":null,"bookingAvailableCode":"RI03","bookingAvailableValue":0,"addressJson":{"jibun":"서울특별시 성동구 성수동2가 277-52, 아모레성수 2층 STORY A 성수","jibunDetail":null,"roadAddr":"서울특별시 성동구 아차산로11길 7, 아모레성수 2층 STORY A 성수","roadDetail":null,"detail":null,"placeName":null,"posLat":37.5445488,"posLong":127.0590548,"zoomLevel":12,"address":"서울특별시 성동구 아차산로11길 7, 아모레성수 2층 STORY A 성수 (서울특별시 성동구 성수동2가 277-52, 아모레성수 2층 STORY A 성수)","globalAddress":null,"miniMap":null,"isImpLocationGuide":true,"zipCode":"04797"},"eventDescJson":[{"desc":"방탈출 이용 고객 아모레성수 전제품 10% 할인쿠폰 증정","impEndDate":"2026-09-10","isImpPeriod":true,"eventEndDate":"2026-08-10","impStartDate":"2026-07-28","isEventPeriod":false,"eventStartDate":"2026-07-10"}],"extraDescJson":[],"additionalPropertyJson":{"openingHoursSetting":null,"runningTime":null,"ageRatingSetting":null,"ticketingTypeSetting":null,"parkingInfoSetting":{"isParkingSupported":false,"isFreeParking":false,"parkingCharge":{"chargingTypeCode":"HOURS","basicCharge":{"time":30,"price":null,"isFree":false},"extraCharge":{"time":30,"price":null,"isFree":false},"maxPrice":null},"valetParking":{"valetParkingType":"NA","price":null},"parkingInfoDetail":null},"accommodationAdditionalProperty":null,"fishSpecies":null,"isUseScore":false,"refundSetting":null,"seatCount":null,"employeeCount":null,"snsInfos":null,"arrangementCountSetting":null,"bizItemCategorySpecificSetting":null},"placeScheduleJson":{"checkin":null,"bizHours":null,"checkout":null},"displaySettingJson":{"backgroundColor":"#90282f","popupSkinSetting":null,"bizItemListingType":"MIXED"},"businessCategory":"DL65","email":"storya_official@naver.com","phoneInformationJson":{"phoneList":[],"reprPhone":"0507-1346-3624"},"tableJson":null,"desc":"아모레성수 7년의 여정을 추억하는 뷰티 서바이벌 프로그램.\n\n파이널 매치가 끝난 직후, 우승자가 의문의 죽음을 맞았습니다.\n현장에는 저마다의 비밀을 숨긴 용의자들과 아직 밝혀지지 않은 진실만이 남았습니다.\n\n이제 사건을 해결할 사람은 당신뿐입니다.\n\n당신은 특별수사팀의 수사관이 되어 현장 곳곳의 단서를 수집하고, 거짓과 진실을 구분하며 사건의 전말을 밝혀내야 합니다.\n\n과연 당신은 범인을 찾아낼 수 있을까요?\n\n아모레성수 2층 STORY A 성수에서 크라임씬 형식의 오픈형 방탈출 콘텐츠 \u003c뷰티 서바이벌 살인사건>을 경험해 보세요.","promotionDesc":null,"serviceName":"STORY A 성수 : 뷰티서바이벌 살인사건","refundTimeOffset":-7,"bookingConfirmCode":"CF02","uncompletedBookingProcessCode":"UC01","uncompletedBookingRefundRate":null,"bookingTimeUnitCode":"RT03","isAllRefundAgreed":false,"translationStatusJson":null,"websiteUrl":"https://www.instagram.com/storya_official","websiteUrlJson":[],"isRequestMessageUsed":false,"isPhoneAuthenticationRequired":false,"customFormJson":[{"type":"SELECT","title":"예약 전날 17시부터는 환불이 불가하오니, 예약 시간을 꼭 확인 후 진행해 주세요.","originalTitle":"예약 전날 17시부터는 환불이 불가하오니, 예약 시간을 꼭 확인 후 진행해 주세요.","required":"y","options":[{"idx":0,"value":"네 알겠습니다.","originalValue":"네 알겠습니다."}],"perItem":"n","isTemporal":"n","isPersonalInfo":"n"},{"type":"SELECT","title":"예약 인원 수 만큼 체험권을 예약해주세요. ex)2명일 경우, 체험권 2장","originalTitle":"예약 인원 수 만큼 체험권을 예약해주세요. ex)2명일 경우, 체험권 2장","required":"y","options":[{"idx":0,"value":"네, 예약자 수 만큼 예약했습니다. 미준수시 환불 없이 취소 될 수 있는점 인지 하였습니다.","originalValue":"네, 예약자 수 만큼 예약했습니다. 미준수시 환불 없이 취소 될 수 있는점 인지 하였습니다."}],"perItem":"n","isTemporal":"n","isPersonalInfo":"n"},{"type":"SELECT","title":"아동 1명당 보호자 1인 동반 필수, 평일 전 연령/주말 만 10세 이상 이용 가능합니다.","originalTitle":"아동 1명당 보호자 1인 동반 필수, 평일 전 연령/주말 만 10세 이상 이용 가능합니다.","required":"y","options":[{"idx":0,"value":"네 알겠습니다. 미준수시 환불 없이 취소 될 수 있는점 인지 하였습니다.","originalValue":"네 알겠습니다. 미준수시 환불 없이 취소 될 수 있는점 인지 하였습니다."}],"perItem":"n","isTemporal":"n","isPersonalInfo":"n"},{"type":"SELECT","title":"마지막 타임은 마감 시간의 영향으로 지각 시 이용이 어려우시며 예약이 취소될 수 있습니다.","originalTitle":"마지막 타임은 마감 시간의 영향으로 지각 시 이용이 어려우시며 예약이 취소될 수 있습니다.","required":"y","options":[{"idx":0,"value":"네, 마지막 타임 예약의 경우 5분 이상 늦을 시 현장 미환불 취소될 수 있는 점 인지 하였습니다.","originalValue":"네, 마지막 타임 예약의 경우 5분 이상 늦을 시 현장 미환불 취소될 수 있는 점 인지 하였습니다."}],"perItem":"n","isTemporal":"n","isPersonalInfo":"n"}],"isImp":true,"cbizNumber":null,"eventDesc":null,"bookingUrl":"https://booking.naver.com/booking/12/bizes/","isPartialCancelUsed":true,"isDeleted":false,"editedDateTime":"2026-08-27T08:11:51Z","regDateTime":"2026-07-10T05:10:42Z","placeObjectId":null,"isImpPlace":true,"isImpMyOwnPlace":true,"placeStatusCode":"approved","isPlaceHidden":false,"placeCategoryId":"1006684","placeCategoryName":"팝업스토어-일반","editorId":"1387491","isImpRefund":false,"isCompletedButtonImp":true,"isSmsReceived":false,"isSmsNightReceived":false,"isEmsReceived":false,"isArsReceived":false,"isArsNightReceived":false,"isCommissionTermsAgreed":true,"arsPhoneInformation":null,"adminBookingTermsDate":null,"bookingGuideJson":[{"isActive":true,"words":"** 방탈출 이용 안내 설명은 한번에 진행되기에 정시에 맞춰 방문 부탁드립니다.\n 늦으실 경우, 다음 예약으로 시간이 밀려 대기가 길어질 수 있으며, 다음 시간 예약이 인원이 많은 경우, 다른 뒷 시간대로 안내드리게 될 수 있습니다.\n\n**예약 전날 17시 부터 어떤 사유로든 취소가 불가하며, 결제된 체험권은 환불되지 않습니다.\n\n**방탈출 최대 70분 정도 소요되는 점 참고 부탁드립니다. "}],"bookingCancelGuideJson":[{"isActive":false,"words":"예약 전일 17시 부터 예약금은 환불되지 않습니다. 이점 꼭 유의하셔서 예약 취소 부탁드립니다."}],"smsTurnoffStartTime":"22:00:00","smsTurnoffEndTime":"09:00:00","arsTurnoffStartTime":"22:00:00","arsTurnoffEndTime":"09:00:00","bookingAlarmCode":"RS01","ownerId":"1387491","isPossibleUserCancel":true,"legalInfoJson":{"allergy":null,"nutrition":null,"originPlace":null,"isAllInOneUrl":null,"originPlaceUrls":null},"isImpMain":false,"isImpBenefitAtMain":false,"businessCategoryConf":null,"hasOptionGroup":false,"isUseOptionGroup":null,"npaySettingJson":{"__typename":"nPaySettingJson","merchantVersion":null},"coordinates":[127.0590548,37.5445488],"businessResources":[{"__typename":"BusinessResource","businessResourcesSeq":null,"businessId":"1696844","order":0,"reso