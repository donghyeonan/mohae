						$("#searchKeyword").focus();
						return false;
					}
				$("#searchForm").submit();
				}
				
				function preLogin(url){
					var obj = document.userForm;
				 	obj.refresh_url.value = "https://sports.seoul.go.kr"+ url;
				 	goLogin2();
				}
				
				function goLogin(){
					var obj = document.userForm;
					obj.submit();
				}
				
				function goLogin2(){
