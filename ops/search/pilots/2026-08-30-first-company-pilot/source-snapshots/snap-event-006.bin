<script>
	// 현재 페이지의 부모 메뉴에 'on' 클래스 추가
	$(document).ready(function() {
		// 현재 URL 경로와 현재 메뉴 정보
		var currentPath = window.location.pathname;
		
		// 1. 현재 메뉴의 depth가 3인 경우 (하위 메뉴 페이지)
		
			// 하위 메뉴의 링크를 확인하여 현재 페이지와 일치하는 메뉴 찾기
			$(".left-dp2 a").each(function() {
				var linkHref = $(this).attr("href");
				
				// 링크와 현재 경로가 일치하는지 확인
				if (linkHref && linkHref.indexOf("#") !== 0 && (currentPath.indexOf(linkHref) !== -1 || linkHref.indexOf(currentPath) !== -1)) {
					// 해당 하위 메뉴에 'on' 클래스 추가
					$(this).parent("li.dw").addClass("on");
					
					// 해당 하위 메뉴의 부모 메뉴(depth1의 li.dw)에 'on' 클래스 추가
					// parents()를 사용하여 상위 li.dw를 찾음
					var parentLi = $(this).parents("li.dw").eq(1); // 첫 번째 li.dw는 하위 메뉴, 두 번째가 부모
					if (parentLi.length > 0) {
						parentLi.addClass("on");
					}
					
					// 해당 하위 메뉴가 속한 .left-dp2와 형제 요소인 모든 .left-dp2를 표시
					var currentDp2 = $(this).closest("ul.left-dp2");
					currentDp2.css("display", "block");
					
					// 같은 부모를 가진 형제 .left-dp2들도 모두 표시
					currentDp2.siblings("ul.left-dp2").css("display", "block");
				}
			});
		
		
		// 2. 현재 메뉴의 depth가 2인 경우 (2차 메뉴 페이지)
		
		
		// 3. 현재 메뉴 정보를 localStorage에 저장 (다른 페이지에서 활용)
		var currentMenuInfo = {
			mtIdx: "MN04041000",
			mtDepth: "3",
			path: currentPath,
			timestamp: new Date().getTime()
		};
		
		
			// depth가 3인 경우 부모 메뉴 정보 저장
			
				
			
				
			
				
			
				
			
				
			
				
			
				
			
				
			
				
			
				
			
				
					currentMenuInfo.parentMtIdx = "MN04000000";
					currentMenuInfo.parentMtName = "시민참여 프로그램";
				
			
				
			
				
			
				
			
		
		
		// localStorage에 현재 메뉴 정보 저장
		localStorage.setItem("currentMenuInfo", JSON.stringify(currentMenuInfo));
		
		// console.log for debugging (운영시 주석 처리)
		// console.log("현재 메뉴 정보:", currentMenuInfo);
	});
</script>
					
					

	      







<script>

var cPage = 1;
var loginSessionID  = "";
var glformType="E"
$(document).ready(function(){
	
/* 	if(glformType == "F"){  //기존에 폼타입일때만 참여후기 노출되었었음
		getComment(cPage);
	} */
	getComment(cPage);
	$('#insertComm').click(function(){
		 if(loginSessionID == "" || loginSessionID==null){ //참여후기 등록 클릭시 (수정됨)
		 alert("로그인 후 이용해 주세요.")
		 	 window.location="/main/login/userLogin.do";
		return false;
	} 
	$('.ppbg').show();
	$('.lypp-wp').show();
	});
	$('.lypp-bk .close').click(function(){
		$('.ppbg').hide();
		$('.lypp-wp').hide();
		$("#pct_title").val(null);
		$("#pct_cont").val(null);
		$("#filePath").val(null);
		$("#insertComm").focus(); // 2020-12-08 추가
	});
	$("#cancelBtn").click(function() {
		$('.ppbg').hide();
		$('.lypp-wp').hide();
		$("#pct_title").val(null);
		$("#pct_cont").val(null);
		$("#attFile").val(null);
		$("#filePath").val(null);
	})
	$('#insertBtn').click(function(){
		var insertCommentFrm = document.insertCommentFrm;
		if(!fnIsValidRequired(insertCommentFrm.pct_title, "제목")){return false;}
		if(!fnIsValidRequired(insertCommentFrm.pct_cont, "내용")){return false;}
		
		$("#insertCommentFrm").submit();
		$('.ppbg').hide();
		$('.lypp-wp').hide();	
	});

	$('.file-bk .ffbt').click(function(){
		$(this).parents('.file-bk').find('input[type="file"]').click();
	});
	
	$("#attFile").change(function() {
		$("#filePath").val($('input[type=file]')[0].files[0].name);
		
	});
	
	
	var image = "FID00003098";
	if(image != null){
	$("#bgImage").css({"background-image":"url(/file/view/"+image+"/0.do)"});
	}
		
}); 
function delComment(pct_idx) {
	if(confirm("정말로 삭제 하시겠습니까?")){
	
	fnDoCallBackAjax('comment_del.json','pct_idx='+pct_idx,function(data){
		if(data.result == 'success'){
			getComment(cPage);
			alert(data.resMsg);
			
		}else{
			alert(data.resMsg);	
		}
	
	})
	}else{
		return false;
	}
	
}
function getComment(pPage){
	fnDoCallBackAjax('/main/SP04100000_user/comment_list.json', $("#frm").serialize() + '&cp=' + pPage + "&pageSize=5",function(data){
		if(data.result == 'success'){
			/* if(cPage == 1){
				for(var i = $("#tb_list tr").length; i > 0; i--){
					$("#tb_list tr:eq("+i+")").remove();
				}
			} */
			var html = "";
			if(data.paging.result.length > 0){
				for(var i = 0; i < data.paging.result.length; i++){
					var item = data.paging.result[i];
					
					html += "<li><div class='zl'><div class='un'>";
					html += "<div class='avt'><img src='/resources/main/images/sub/s4lsl_avt2.png' alt=''></div>";
					html += "<div>"+item.mem_name+"</div></div>";
					html += "<div class='ti'><p><a href='#n'>"+item.pct_title+"</a></p></div><div class='dt'>"+item.inputdate.substring(0,11)+"</div></div>";
					html += "<div class='cbk' style='display: block;'><div>";
					html += "<div class='cbx'><p class='ibx'><img src='/file/view/"+item.atch_file_id+"/0.do' alt=''></p>";
					html += "<div class='tx'>"+item.pct_cont+"</div></div>";
					if(item.in_mem_id == loginSessionID){
					html += "<div class='btb'><a href='#n' onClick='delComment("+item.pct_idx+");' class='ss-btn Xic'>삭제</a></div>";
					}
					html += "</div></div></li>";
				}	
				$(".lts-ls").html(html);
				$('.lts-ls .cbk').attr('style','display:none;');
				
			}else{
					html += " <div>등록된 후기가 없습니다.</div>";
					$(".lts-lsn").html(html);
					$(".lts-ls").html("");
			}
			
			$(".bls-pg").html(data.paging.userAjaxTextTagOnlyPageNum);
			
			$('.lts-ls .zl .ti a').click(function(){
				if ($(this).parents('.lts-ls > li').hasClass('on')){
					$('.lts-ls > li').removeClass('on');
					$('.lts-ls .cbk').slideUp(120);
				}else{
					$('.lts-ls > li').removeClass('on');
					$('.lts-ls .cbk').slideUp(120);
					$(this).parents('.lts-ls > li').addClass('on');
					$(this).parents('.lts-ls > li').find('.cbk').slideDown(200);
				}
			});
			
			return;
		}else{
			alert(data.resMsg);	
		}
	} 
	);
}

function pageMove(pPage){
	cPage = pPage
	getComment(pPage);
	return false;
}

</script>

