	function fnCancelReply(idx){

		//$(".cmt_list .cmt_txt:eq("+idx+")").prop("readonly", true);

		$(".cmt_list .cmt_txt3:eq("+idx+")").css("display", "block");
		$(".cmt_list .cmt_txt2:eq("+idx+")").css("display", "none");

		$(".cmt_list > li:eq("+idx+") .btn_0").css("display", "inline-block");
		$(".cmt_list > li:eq("+idx+") .btn_1").css("display", "inline-block");
		$(".cmt_list > li:eq("+idx+") .btn_2").css("display", "none");
		$(".cmt_list > li:eq("+idx+") .btn_3").css("display", "none");

	}

	// 이용후기 수정버튼 클릭
	function fnOpenReplyForm(idx, stsfdg_seq,svcid,score){
		$(".cmt_list .btn_0").css("display", "inline-block");
		$(".cmt_list .btn_1").css("display", "inline-block");
		$(".cmt_list .btn_2").css("display", "none");
		$(".cmt_list .btn_3").css("display", "none");
		$(".cmt_list .cmt_txt2").css("display", "none");
		$(".cmt_list .cmt_txt3").css("display", "block");
		$(".cmt_list .cmt_txt2:eq("+idx+")").val($('#'+stsfdg_seq).text());
		$(".cmt_list .cmt_txt2:eq("+idx+")").attr('title', '이용후기를 입력해주세요.');;

		$(function() {
			$("#score").val(score);
		});

		//$(".cmt_txt").prop("readonly", true);
		//$(".cmt_list .cmt_txt:eq("+idx+")").prop("readonly", false);
		$(".cmt_list .cmt_txt3:eq("+idx+")").css("display", "none");
		$(".cmt_list .cmt_txt2:eq("+idx+")").css("display", "block");
		$(".cmt_list .cmt_txt2:eq("+idx+")").focus();
		$('.rate_box_re button').css("display", "inline-block");
		$('.rate_box_re span').css("display", "none");

		//초기화
		$(".cmt_list > li:eq("+idx+") .btn_0").css("display", "none");
		$(".cmt_list > li:eq("+idx+") .btn_1").css("display", "none");
		$(".cmt_list > li:eq("+idx+") .btn_2").css("display", "inline-block");
		$(".cmt_list > li:eq("+idx+") .btn_3").css("display", "inline-block");
		return;

		//$("#"+stsfdg_seq).prop("readonly", false);
		//$("#"+stsfdg_seq).focus();


		if(document.getElementById('logincheck').value == "N"){
			alert("예약을 하기 위해서는 로그인이 필요합니다.");
		}else{
			if ($('#'+stsfdg_seq).val() == "") {
				alert("이용후기를 작성해주세요.");
				$('#'+stsfdg_seq).focus();
				return;
			}

			if($('#'+stsfdg_seq).prop('readonly') == true){
				$('#'+stsfdg_seq).prop('readonly',false);
			}else{
			var req ={
					"stsfdg_seq" : stsfdg_seq,
					"svcid" : svcid,
					"cn" : $('#'+stsfdg_seq).val(),
					"score" : $("#score").val()
				};

				jQuery.ajax( {
					type : 'POST',
					dataType : 'json',
					url : '/web/reservation/updateReviewInfo.do',
					data : req,
					success : function(param) {

						if(param.resultStats.resultCode == "error"){
							alert(param.resultStats.resultMsg);
							return;
						}
						alert("완료되었습니다.");
						location.reload();
					},
					error : function(jqXHR, textStatus, thrownError){
						ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
					}
				});
			}
		}
	}

	// 개인정보 필터링
	function fnValidatePrivacy(url, form, lang){
		var formData = {'hostIp' : '', 'HostUrl' : url , 'userIp' : ''};
		var result = new Array;
		$.ajax( {
			type : 'post',
			dataType :'json',
			url : 'https://api240.eseoul.go.kr:5443/UPServer/?' + form,
			data : formData,
			async : false,
			success : function(data) {
				result[0] = data.privacy[0].isPriv;
				result[1] = data.privacy[0].privContent;
			},
			error : function(jqXHR, textStatus, thrownError){
				ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
			}
		});

		return result;
	}

	// 이용후기 수정확인 버튼
	function fnDeUpdate(idx, stsfdg_seq,svcid,score){

		var form = $('#aform').serialize();
		var url = "https://yeyak.seoul.go.kr/web/reservation/selectReservView.do";

		var privacy_val = new Array;
		privacy_val = fnValidatePrivacy(url, form, "ko");
		if(privacy_val[0] == '1'){
			alert("개인정보가(" + privacy_val[1] + ")가 포함되어 있어 등록이 불가능합니다.");
			return false
		}

		$(function() {
			$("#score").val(score);
		});

		if(document.getElementById('logincheck').value == "N"){
			alert("예약을 하기 위해서는 로그인이 필요합니다.");
		}else{
			if ($('#'+stsfdg_seq).val() == "") {
				alert("이용후기를 작성해주세요.");
				$('#'+stsfdg_seq).focus();
				return;
			}

			if($('#'+stsfdg_seq).prop('readonly') == true){
				$('#'+stsfdg_seq).prop('readonly',false);
			}else{
			var req ={
					"stsfdg_seq" : stsfdg_seq,
					"svcid" : svcid,
					"cn" : $('#'+stsfdg_seq).val(),
					"score" : $("#score").val()
				};
			if(confirm("수정하시겠습니까?")){
				jQuery.ajax( {
					type : 'POST',
					dataType : 'json',
					url : '/web/reservation/updateReviewInfo.do',
					data : req,
					success : function(param) {

						if(param.resultStats.resultCode == "error"){
							alert(param.resultStats.resultMsg);
							return;
						}

						fnReviewAjax();
						alert("완료되었습니다.");
						//location.reload();
					},
					error : function(jqXHR, textStatus, thrownError){
						ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
					}
				});
			}
		}
	}
}

	// 이용후기 삭제
	function fnDelete(svcid,rsvmmbsn,reviewnum){
		if(document.getElementById('logincheck').value == "N"){
			alert("예약을 하기 위해서는 로그인이 필요합니다.");
		}else{
			if(confirm("이용후기를 삭제하시겠습니까?")){
				var req ={
						"svcid" : svcid,
						"rsvmmbsn" : rsvmmbsn,
						"reviewnum" : reviewnum
					};

					jQuery.ajax( {
						type : 'POST',
						dataType : 'json',
						url : '/web/mypage/DeleteReviewAjax.do',
						data : req,
						success : function(param) {

							if(param.resultStats.resultCode == "error"){
								alert(param.resultStats.resultMsg);
								return;
							}
							alert("이용후기가 삭제되었습니다.");
							fnReviewAjax();
						},
						error : function(jqXHR, textStatus, thrownError){
							ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
						}
					});
				}
		}
	}


	// 별점 클릭 이벤트
	$(function(){
		$('.rate_box button').on('click', function(e){
			e.preventDefault();
			e.stopPropagation();
			var star = $(this).attr('id');
			switch(star){
			case "1" : $('.cmt_tit1').text("매우나쁨");
			break;
			case "2" : $('.cmt_tit1').text("나쁨");
			break;
			case "3" : $('.cmt_tit1').text("보통");
			break;
			case "4" : $('.cmt_tit1').text("좋음");
			break;
			case "5" : $('.cmt_tit1').text("매우좋음");
			break;
			}
		});
});

