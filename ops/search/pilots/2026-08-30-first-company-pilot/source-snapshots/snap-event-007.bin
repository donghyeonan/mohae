	// 첨부파일 다운로드
	function fnDownload(file_id) {
		$('[name=file_id]').val(file_id);
		$('#aform').attr({'action' : '/common/file/FileDown.do'}).submit();
	}

	//바로보기
	function previewAjax(file_id,file_name){
		var host = window.location.origin;
		var apiKey = "JEXCMD9JV7OJWAFSPICTDA";
		var cc = "sg_089";
		var file_url = host +"/common/file/FileDown.do?file_id="+file_id;
		var fileUrl = encodeURIComponent(file_url);
		var fileName = encodeURIComponent(file_name);
		window.open ("https://seoul.viewstory.net/previewAjax.do?apikey={0}&cc={1}&url={2}&fileName={3}".format(apiKey,cc,fileUrl,fileName),"a","width=1200, height=1000, left=100, top=50");
	}

	//바로듣기
	function preListen(file_id,file_name){
		var host = window.location.origin;
		var apiKey = "JEXCMD9JV7OJWAFSPICTDA";
		var cc = "sg_089";
		var file_url = host + "/common/file/FileDown.do?file_id="+file_id;
		var fileUrl = encodeURIComponent(file_url);
		var fileName = encodeURIComponent(file_name);
		window.open ("https://seoul.viewstory.net/voiceOverAjax.do?apikey={0}&cc={1}&url={2}&fileName={3}".format(apiKey,cc,fileUrl,fileName), "a", "width=1200, height=1000, left=100, top=50");
	}

	String.prototype.format = function() {
	   var formatted = this;
	   for( var arg in arguments ) {
	      formatted = formatted.replace("{" + arg + "}", arguments[arg]);
	   }
	   return formatted;
	};

	// 서비스 문자알림 체크박스 수정
	function fnUpdatPopup() {
		if(document.getElementById('logincheck').value == "N"){
			alert("예약을 하기 위해서는 로그인이 필요합니다.");
		}else{
			var checkBox1;
			var checkBox2;
			var checkBox3;
			if ($('input:checkbox[name=chk_sms1]').is(':checked') == true) {
				checkBox1 = 'Y';
			} else {
				checkBox1 = 'N';
			}
			if ($('input:checkbox[name=chk_sms2]').is(':checked') == true) {
				checkBox2 = 'Y';
			} else {
				checkBox2 = 'N';
			}
			if ($('input:checkbox[name=chk_sms3]').is(':checked') == true) {
				checkBox3 = 'Y';
			} else {
				checkBox3 = 'N';
			}
				var req = {
					"svcid" : $("#rsv_svc_id").val(),
					"rsv_svc_id" : $("#rsv_svc_id").val(),
					"chksms1" : checkBox1,
					"chksms2" : checkBox2,
					"chksms3" : checkBox3
				};

				jQuery.ajax({
					type : 'POST',
					dataType : 'json',
					url : '/web/mypage/selectPageListSmsUpdateAjax.do',
					data : req,
					success : function(param) {

						if (param.resultStats.resultCode == "error") {
							alert(param.resultStats.resultMsg);
							return;
						}
						alert("완료되었습니다.");
						var str = "" ;
						if(param.resultList.length == 0){
							str += '<button type="button" class="common_btn white" data-popx="">';
							str += '취소하기';
							str += '</button>';
							str += '<button type="button" class="common_btn white" onclick="fnUpdatPopup();">';
							str += '신청하기';
							str += '</button>';
						}else{
							str += '<button type="button" class="common_btn white" data-popx="">';
							str += '취소하기';
							str += '</button>';
							str += '<button type="button" class="common_btn white" onclick="fnUpdatPopup();">';
							str += '수정';
							str += '</button>';
						}
						$('#smsCheck').html(str);

						for (i=0 ; i < param.resultList.length; i++) {
						if (param.resultList[i].REQST_RCEPT_NTCN_YN == "Y") {
							$("#chk_sms1").val('Y');
							$("input:checkbox[id='chk_sms1']").prop("checked", true);
						} else {
							$("input:checkbox[id='chk_sms1']").prop("checked", false);
						}
						if (param.resultList[i].REQST_CLOS_NTCN_YN == "Y") {
							$("#chk_sms2").val('Y');
							$("input:checkbox[id='chk_sms2']").prop("checked", true);
						} else {
							$("input:checkbox[id='chk_sms2']").prop("checked", false);
						}
						if (param.resultList[i].NOTICE_NTCN_YN == "Y") {
							$("#chk_sms3").val('Y');
							$("input:checkbox[id='chk_sms3']").prop("checked", true);
						} else {
							$("input:checkbox[id='chk_sms3']").prop("checked", false);
						}
						}
					},
					error : function(jqXHR, textStatus, thrownError) {
						ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
					}
				});
			}
		}

	// 서비스문자알림 리스트
	function fnSeviceCheck() {
			var req = $('#aform').serialize();

			jQuery.ajax({
				type : 'POST',
				dataType : 'json',
				url : '/web/reservation/selectServiceCheck.do',
				data : req,
				success : function(param) {

					if (param.resultStats.resultCode == "error") {
						alert(param.resultStats.resultMsg);
						return;
					}
					var str = "" ;
					if(param.resultList.length == 0){
						str += '<button type="button" class="common_btn white" data-popx="">';
						str += '취소하기';
						str += '</button>';
						str += '<button type="button" class="common_btn white" onclick="fnUpdatPopup();">';
						str += '신청하기';
						str += '</button>';
					}else{
						str += '<button type="button" class="common_btn white" data-popx="">';
						str += '취소하기';
						str += '</button>';
						str += '<button type="button" class="common_btn white" onclick="fnUpdatPopup();">';
						str += '수정';
						str += '</button>';
					}
					$('#smsCheck').html(str);

					for (i=0 ; i < param.resultList.length; i++) {
					if (param.resultList[i].REQST_RCEPT_NTCN_YN == "Y") {
						$("#chk_sms1").val('Y');
						$("input:checkbox[id='chk_sms1']").prop("checked", true);
					} else {
						$("input:checkbox[id='chk_sms1']").prop("checked", false);
					}
					if (param.resultList[i].REQST_CLOS_NTCN_YN == "Y") {
						$("#chk_sms2").val('Y');
						$("input:checkbox[id='chk_sms2']").prop("checked", true);
					} else {
						$("input:checkbox[id='chk_sms2']").prop("checked", false);
					}
					if (param.resultList[i].NOTICE_NTCN_YN == "Y") {
						$("#chk_sms3").val('Y');
						$("input:checkbox[id='chk_sms3']").prop("checked", true);
					} else {
						$("input:checkbox[id='chk_sms3']").prop("checked", false);
					}
					}

				},
				error : function(jqXHR, textStatus, thrownError) {
					ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
				}
			});
		}

