<script>

document.addEventListener("DOMContentLoaded", function () {

	let isKeyboardNavigation = false;
	// 키보드 사용 여부 감지
	document.addEventListener("keydown", function (e) {
		if (e.key === "Tab" || e.key === "Enter" || e.key === "ArrowDown" || e.key === "ArrowUp") {

			isKeyboardNavigation = true;

		}
	});

	// 마우스 조작이면 false로 되돌림
	document.addEventListener("mousedown", function () {

		isKeyboardNavigation = false;

	});

	document.querySelectorAll('.menu-toggle').forEach(function (el) {
		const targetId = el.getAttribute('aria-controls');
		const target = document.getElementById(targetId);
		const parentLi = el.closest('.has-submenu');

		if (!target || !parentLi) return;

		// 클릭 이벤트 (마우스 클릭 및 기본 키보드 스페이스)
		el.addEventListener('click', function (e) {
			e.preventDefault();
			const expanded = el.getAttribute('aria-expanded') === 'true';
			el.setAttribute('aria-expanded', String(!expanded));

			if (!expanded) {
				target.hidden = false;
				target.style.display = 'block';
			} else {
				target.hidden = true;
				target.style.display = 'none';
			}
		});

		// 키보드 엔터 및 스페이스키 토글 기능 추가
		el.addEventListener('keydown', function (e) {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				const expanded = el.getAttribute('aria-expanded') === 'true';
				el.setAttribute('aria-expanded', String(!expanded));

				if (!expanded) {
					target.hidden = false;
					target.style.display = 'block';
				} else {
					target.hidden = true;
					target.style.display = 'none';
				}
			}
		});

		// hover 진입 시 메뉴 열기 (단, 키보드 조작 중이 아닐 때만)
		parentLi.addEventListener('mouseenter', () => {

			if (!isKeyboardNavigation) {
				el.setAttribute('aria-expanded', 'true');
				target.hidden = false;
				target.style.display = 'block';
			}
		});

		// hover 벗어나면 닫기
		parentLi.addEventListener('mouseleave', () => {
			el.setAttribute('aria-expanded', 'false');
			target.hidden = true;
			target.style.display = 'none';
		});

		// focus 진입 시 메뉴 열기
		el.addEventListener('focus', () => {
			el.setAttribute('aria-expanded', 'true');
			target.hidden = false;
			target.style.display = 'block';
		});

		// focus 나갈 시 메뉴 닫기
		el.addEventListener('blur', () => {
			setTimeout(() => {
				if (!parentLi.contains(document.activeElement)) {
					el.setAttribute('aria-expanded', 'false');
					target.hidden = true;
					target.style.display = 'none';
				}
			}, 100);
		});

		// 하위 메뉴에서 포커스 아웃되었을 때 닫기
		target.addEventListener('focusout', () => {

			setTimeout(() => {
				if (!parentLi.contains(document.activeElement)) {
					el.setAttribute('aria-expanded', 'false');
					target.hidden = true;
					target.style.display = 'none';
				}
			}, 100);
		});
	});
});

</script>
