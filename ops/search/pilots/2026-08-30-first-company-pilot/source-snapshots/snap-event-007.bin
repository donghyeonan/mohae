			if(confirm('로그인 하시겠습니까?')){
				window.location="/web/loginForm.do";
			}else{

			}
	}

	// 이용후기 등록
	function fnReviewInsert(){

		var form = $('#aform').serialize();
		var url = "https://yeyak.seoul.go.kr/web/reservation/selectReservView.do";

		var privacy_val = new Array;
		privacy_val = fnValidatePrivacy(url, form, "ko");
		if(privacy_val[0] == '1'){
			alert("개인정보가(" + privacy_val[1] + ")가 포함되어 있어 등록이 불가능합니다.");
			return false
		}

		if(document.getElementById('logincheck').value == "N"){
			if(confirm('로그인 하시겠습니까?')){
				window.location="/web/loginForm.do";
			}else{

			}
		}else{
			if ($("[name=form_txt]").val() == "") {
				alert("이용후기를 작성해주세요.");
				$("[name=form_txt]").focus();
				return;
			}else if($(' button').hasClass('on') == false){
				alert("별점을 입력해주세요.");
				return;
			}else{
				var cn = $("[name=form_txt]").val();
				var rsv_svc_id = $("[name=rsv_svc_id]").val();
	 			var score_result = $('.cmt_tit1').text();
	 			var score;
	 			switch(score_result){
	 			case "매우나쁨" : score = "1";
				break;
				case "나쁨" : score = "2";
				break;
				case "보통" : score = "3";
				break;
				case "좋음" :score = "4";
				break;
				case "매우좋음" : score = "5";
				break;
	 			}



	 			var req ={
						"cn" : cn,
						"rsv_svc_id" : rsv_svc_id,
						"score" : score
					};

	 			$.ajax( {
					type : 'POST',
					dataType : 'json',
					url : '/web/reservation/selectComentChkAjax.do',
					data : req ,
					success : function(param) {
						if(param.resultStats.resultCode == 'error'){
							alert("서비스를 이용한 사용자만 작성할 수 있습니다.");
							return;
						}else{

							jQuery.ajax( {
								type : 'POST',
								dataType : 'json',
								url : '/web/reservation/insertFormReview.do',
								data : req,
								success : function(param) {

									if(param.resultStats.resultCode == "error"){
										alert(param.resultStats.resultMsg);
										return;
									}
									alert("이용후기가 작성되었습니다.");
									$('textarea').val('');
									$('.rate_box button').attr('class','star');
									fnReviewAjax();
									$('.cmt_tit1').text("공공시설을 직접 이용한 이용자들의 이용후기를 확인하세요.");
								},
								error : function(jqXHR, textStatus, thrownError){
									ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
								}
							});

						}
					},
					error : function(jqXHR, textStatus, thrownError){
						ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
					}
				});

// 				$("#aform").attr({action:"/web/reservation/insertFormReview.do?cn="+cn+'&score='+score, method:'post'}).submit();
// 				alert("이용후기가 작성되었습니다.");
				}
		}
	}

	//페이지이동
	function fnGoPage2(currentPage){
		$("#currentPage2").val(currentPage);
		fnReviewAjax();
	}

	function getParam(key){
		return new URLSearchParams(location.search).get(key);
	};

	//서비스 상세 페이지
	function fnDetailPage(id){
		document.location.href="/web/reservation/selectReservView.do?rsv_svc_id="+id;
	}

	//최근 본 서비스
	function fnRecentSvc(){

		var txt = "recent_svc_id_ko";
		var str = localStorage.getItem(txt);

		if(localStorage.getItem(txt) != null) {

			$.ajax({
				url: '/web/reservation/selectListRecentSvcAjax.do',
				data: { 'recent_svc_id' : str, 'locale' : 'ko', 'now_svc_id': $('[name=rsv_svc_id]').val() },
				type:'POST',
				dataType:'json',
				success:function(param){
					if(param.resultStats.resultCode == 'error'){
						alert(param.resultStats.resultMsg);
						return;
					}else{

						var strHtml = '';
						// 소분류 그리기
						for(var i = 0; i < param.resultList.length; i++){
							var item = param.resultList[i];
							strHtml += '<a href="#" class="item" onclick="fnDetailPage(\''+item.SVC_ID+'\'); return false;" title="'+item.SVC_NM+'">';
							strHtml += '<div class="img_box">';
							strHtml += '<div class="ib_top">';

							if (item.SVC_STTUS_CODE == 'R402'){
								strHtml += '		<span class="bd_label status2">안내중</span>';
							}else if (item.SVC_STTUS_CODE == 'R403'){
								strHtml += '		<span class="bd_label status1">접수중</span>';
							}else if (item.SVC_STTUS_CODE == 'R405'){
								strHtml += '		<span class="bd_label status4">예약 일시정지</span>';
							}else if (item.SVC_STTUS_CODE == 'R404'){
								strHtml += '		<span class="bd_label status6">접수종료</span>';
							}else if (item.SVC_STTUS_CODE == 'RRRR'){
								strHtml += '		<span class="bd_label status5">예약마감</span>';
							}

							if (item.PCHRG_YN == 'Y'){
								strHtml += '		<span class="bd_label type1">유료</span>';
							}else if (item.PCHRG_YN == 'N'){
								strHtml += '		<span class="bd_label type2">무료</span>';
							}

							strHtml += '</div>';

							// 공백뿐인 설명도 서비스명으로 보완한다.
							var altVal = $.trim(item.IMAGE_DC || '') || item.SVC_NM;
							// 개행문자가 있는 경우, unexpected token 오류 발생
							altVal = altVal.replace(/\r/gi,'\\r').replace(/\n/gi,'\\n');

							if(nvl(item.ATTRB_3) != ''){
								strHtml +='	<img src="/web/common/file/FileDown.do?file_id='+item.FILE_ID+'" alt="'+altVal+' 사진"  onerror="this.src=\'/common/img/no_img.png\'" >'
							}else{
								strHtml += '		<img src="'+item.FILE_PARTN_COURS+item.FILE_ID+'.'+item.FILE_EXTSN_NM;
								strHtml += '" alt="'+altVal+' 사진" onerror="this.src=\'/common/img/no_img.png\'" >';
							}

							strHtml += '<span class="ib_num"> ';

							if (item.SELECT_MTH_CODE == 'R001'){
								strHtml += '		선착순';
							}else if (item.SELECT_MTH_CODE == 'R002'){
								strHtml += '		추첨';
							}else if (item.SELECT_MTH_CODE == 'R003'){
								strHtml += '		심사';
							}

							strHtml += '</span>';
							strHtml += '</div>';
							strHtml += '<div class="con_box">';
							strHtml += '	<ul class="ib_type">';
							strHtml += '		<li>'+item.MXMM_CL_NM+'</li>';
							strHtml += '		<li>'+item.MUMM_CL_NM+'</li>';
							strHtml += '	</ul>';
							strHtml += '	<h4 class="tit1">'+item.SVC_NM+'</h4>';
							strHtml += '</div>';
							strHtml += '</a>';
						}
						$('.recent_svc').html(strHtml);
						initializeRecentServiceSlider();
					}
				}
			});//ajax


		}else{//if
			strHtml = '<span>최근 본 서비스가 없습니다.</span>';
			$('.recent_svc').html(strHtml);
			$('.recent_svc span').css("vertical-align", "middle");
			$('.recent_svc span').css("margin-left", "33%");
			$('.img_attr').html('');
		}

		var valDataArray;
		var addStr = "";

		if(str != null && str !="null"){
			valDataArray = str.split("^");

			if(valDataArray.indexOf($('[name=rsv_svc_id]').val())>=0){
				var strArr = str.split('^').reverse();
				var index = strArr.indexOf($('[name=rsv_svc_id]').val());

				strArr.splice(index,1);
				strArr = strArr.reverse();
				strArr = strArr.join("^");
				localStorage.setItem(txt, strArr);

				valDataArray = strArr.split("^");
				str = localStorage.getItem(txt);
			}

			addStr = "";

			if(valDataArray.length < 8){
				for(i = 0; i < valDataArray.length; i++){

					if($('[name=rsv_svc_id]').val() != valDataArray[i]){
						if(i > 0){
							addStr += "^";
						}
						addStr += valDataArray[i];
					}
				}
				addStr += "^"+$('[name=rsv_svc_id]').val();
			}
			else{
				for(i = 1; i < 8; i++){
					if($('[name=rsv_svc_id]').val() != valDataArray[i]){
						if(i > 1){
							addStr += "^";
						}
						addStr += valDataArray[i];
					}
				}
				addStr += "^"+$('[name=rsv_svc_id]').val();
			}
			localStorage.setItem(txt, addStr);

		}else{
			str = $('[name=rsv_svc_id]').val();
			localStorage.setItem(txt, $('[name=rsv_svc_id]').val());

		}

	}
	// 즐겨찾기 추가/취소
	function fnClickBookmark(type) {
		if (1 == type) {
			// 추가
			if (document.getElementById('logincheck').value == "N"){
				if(confirm('로그인 하시겠습니까?')){
					window.location="/web/loginForm.do";
				} else {
					return;
				}
			}

			var req = {
					"rsv_svc_id" : $("#rsv_svc_id").val(),
					"grp_code" : $("#grp_code").val()
				};
			$.ajax({
				type : 'POST',
				dataType : 'json',
				url : '/web/mypage/addBookmark.do',
				data : req,
				success : function(param) {

					if (param.resultStats.resultCode == "error") {
						alert(param.resultStats.resultMsg);
						return;
					}
					alert("완료되었습니다.");

					//즐겨찾기 버튼 숨기기
					//$(".btn_favorites").hide();
					$(".btn_favorites").css("display", "none");
					$(".btn_favorites_pick").css("display", "inline-block");
				},
				error : function(jqXHR, textStatus, thrownError) {
					ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
				}
			});
		} else {
			// 취소
			var svcid = $("#rsv_svc_id").val();

			if(confirm("즐겨찾기를 취소하시겠습니까?")){

				var req ={
					"rsv_svc_id" : svcid
				};

				jQuery.ajax( {
					type : 'POST',
					dataType : 'json',
					url : '/web/mypage/updateBookmarkAjax.do',
					data : req,
					success : function(param) {

						if(param.resultStats.resultCode == "error"){
							alert(param.resultStats.resultMsg);
							return;
						}
						alert("완료되었습니다.");
						$(".btn_favorites_pick").css("display", "none");
						$(".btn_favorites").css("display", "inline-block");					},
					error : function(jqXHR, textStatus, thrownError){
						ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
					}
				});
			}
		}
	}
	// 해당 서비스를  구독하기
	function fnAddSubscribe(){
		if (document.getElementById('logincheck').value == "N"){
			if(confirm('로그인 하시겠습니까?')){
				window.location="/web/loginForm.do";
			} else {
				return;
			}
		}

		var req = {
				"rsv_svc_id" : $("#rsv_svc_id").val(),
				"grp_code" : $("#grp_code").val()
			};
			$.ajax({
				type : 'POST',
				dataType : 'json',
				url : '/web/mypage/addSubscribe.do',
				data : req,
				success : function(param) {

					if (param.resultStats.resultCode == "error") {
						alert(param.resultStats.resultMsg);
						return;
					}
					alert("완료되었습니다.");

					// 서비스를 구독 후, 구독하기 버튼 숨기기
					$(".btn_favorites").css("display", "none");
				},
				error : function(jqXHR, textStatus, thrownError) {
					ajaxJsonErrorAlert(jqXHR, textStatus, thrownError)
				}
			});
	}

	function fnCopyLink(){
		var url = location.href;

		try {
 			// 서비스 아이디 까지만 복사
 			url = location.href.match(/(^.{1,}\?)(rsv_svc_id=S[0-9]{18})/)[0];
			// 언어 설정
			var locale = ("KOR" == "KOR" ? "ko" : "en");
			url += ("&locale=" + locale);

		} catch (error){}

		$('#urlCopy').val(url);

        var copy = document.getElementById("urlCopy");
        copy.select();

        document.execCommand("Copy");
        alert("URL 주소 복사가 완료되었습니다.");
	}

	function fnTwtShare(){
		window.open("https://twitter.com/intent/tweet?via=&text="+"&url="+encodeURIComponent(location.href));
	}

