s designed to increase comfort and performance. Their products are primarily targeted towards individuals seeking enhanced foot support and comfort. It was founded in 2015 and is based in Woburn, Massachusetts.","hasBlur":false},"highResLogoUrl":{"value":"https://s3-us-west-2.amazonaws.com/cbi-image-service-prd/modified/eae11a69-a58b-4fbe-b6a6-8590f123ac50.png","hasBlur":false},"logoUrl":{"value":"","hasBlur":false},"slug":{"value":"tread-labs","hasBlur":false},"idEntityType":{"value":1,"hasBlur":false}}],"competitorsWithSurveyCount":0,"customers":[],"customer_kpis":[],"customerReferences":[],"partners":[],"products":[],"taxonomy":{}},"esps":[]}}},"__N_SSG":true},"page":"/company/[...name]","query":{"name":["frido","financials"]},"buildId":"2AAjZ8432Z3ekevkGzVWT","assetPrefix":"https://public-pages.cbinsights.com/public-site/667337","isFallback":false,"isExperimentalCompile":false,"gsp":true,"scriptLoader":[]}</script></body></html>