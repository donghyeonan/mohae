	            <input class="form-check-input me-2" type="checkbox" id="hideBannerWeek" name="agreement_1">
	            <label class="form-check-label" for="hideBannerWeek">Don't show again for a week</label>
	            <button id="textbanner-close" type="button" class="btn btn-sm btn-primary mx-3" ><u>Close</u></button>
	        </div>
