			<!-- 공통 script -->
			<script>
				$(document).ready(function() {
					checkBanner();
				});
				
		    	$(document).on("click", "#textbanner-close", function(){
		    		var hideBannerWeekChecked = $("#hideBannerWeek").prop("checked");
		    		let path = "/artfair/"+seDomain+"/"
		    		if(hideBannerWeekChecked){
		    			setPersistentCookie("govent." + seDomain + ".hideBanner", "Y", 7, "d", path); //7일
		    		}else{
		    			setSessionCookie("govent."+seDomain+".hideBanner", "Y", path);	
		    		}
		    		$("#textbanner-box").css("display","none");
		    	});
		    	
		    	function checkBanner() {
		    		if (isBannerHidden()) {
		    			$("#textbanner-box").css("display","none")
		    	    } else {
		    	    	$("#textbanner-box").css("display","block");
		    	    }
		    	}
		    	
		    	function isBannerHidden() {
		    	    return getCookie("govent." + seDomain + ".hideBanner") === "Y";
		    	}
		    	
		    	function goLang(language){
		    		let returnUrl = window.location.pathname;
		    		let lastPathName = returnUrl.match(/\/([^\/]+)\/?$/)[1];
		    		let method = getMethod(lastPathName);
		    		let paramArray = [];
		    		paramArray.push({name : 'lang', value : language});
		    		
		    		if(lastPathName == "pay"){
		    			if(typeof(lang) != "undefined" && lang == "en"){
		    				let phoneNumber = JSON.parse(sessionStorage.getItem("artfair."+seDomain+".userData")).phone;
		    				if(!regexPattern("phone").test(phoneNumber)){
		    					returnUrl = "/artfair/"+seDomain+"/info";
		    					alert("The number you entered is not a valid domestic mobile number format. Please fill it out again.");
		    					postSubmit(returnUrl, paramArray, "goLangForm");
		    				}
		    			}
		    			
		    			let userData = JSON.parse(sessionStorage.getItem("artfair."+seDomain+".userData"));
		    			if(userData != null){
		    				userData.lang = language;
		    				sessionStorage.setItem("artfair."+seDomain+".userData", JSON.stringify(userData));
		    			}
		    		}
		    		
		    		if(typeof(slotType) != "undefined"){
		    			paramArray.push({name : 'slotType', value : slotType});
		    		}
		    		
		    		if(typeof(timeSlotTicketCount) != "undefined" && lastPathName != "index" && lastPathName != "regist"){
		    			paramArray.push({name : 'timeSlotTicketCount', value : timeSlotTicketCount});
		    		}
		    		
		    		if(lastPathName == "orderResult"){
		    			paramArray.push({name : 'sendTicketResultCd', value : sendTicketResultCd});
		    		}
		    		if(method == "post"){
		    	 		postSubmit(returnUrl, paramArray, "goLangForm");
		    		}else{
		    			getSubmit(returnUrl, paramArray, "goLangForm");
		    		}
		    	}
		    	
		    	function getMethod(pathName){
		    		if(pathName == "index" || pathName == "regist" || pathName == "login"){
		    			return "get";
		    		}else{
		    			return "post";
		    		}
		    	}
		    </script>

