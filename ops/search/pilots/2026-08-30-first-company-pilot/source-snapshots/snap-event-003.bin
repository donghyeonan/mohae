												</tr>
											
												<tr class="ticket-soldout">
													<th class="text-start fw-normal">
														<span class="ticket-label">2026 Korea Art Festival Special Discount</span>
														<br>
														General Admission First Access_before 3pm
														<br>
														<small class="text-black-50">(one selected day between Sept. 4 and 5)</small>
													</th>
													<td class="text-black-50 text-center">63,000</td>
													<td class="text-black-50 text-center">$ 45</td>
												</tr>
											
												<tr class="ticket-soldout">
													<th class="text-start fw-normal">
														<span class="ticket-label">2026 Korea Art Festival Special Discount</span>
														<br>
														General Admission Afternoon Access_after 3pm
														<br>
														<small class="text-black-50">(one selected day between Sept. 4 and 5)</small>
													</th>
													<td class="text-black-50 text-center">49,000</td>
													<td class="text-black-50 text-center">$ 35</td>
												</tr>
											
												<tr>
													<th class="text-start">
														
														
														Preview Ticket
														<br>
														<small class="text-black-50">(multi-day access between Sept. 3 and 6)</small>
													</th>
													<td class="text-black-50 text-center">250,000</td>
													<td class="text-black-50 text-center">$ 178</td>
												</tr>
											
												<tr>
													<th class="text-start">
														
														
														General Admission Preview Entry
														<br>
														<small class="text-black-50">(Sept. 3 only)</small>
													</th>
													<td class="text-black-50 text-center">90,000</td>
													<td class="text-black-50 text-center">$ 64</td>
