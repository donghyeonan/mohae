			<p>요청실패.</p>
		</div>
<script>
window.addEventListener('load', function () {
  window.__livereModalPendingTab = false;

  function findAllInShadows(node, selector, results) {
    if (!node) return results || [];
    results = results || [];

    if (node.querySelectorAll) {
      var found = node.querySelectorAll(selector);
      for (var i = 0; i < found.length; i++) {
        results.push(found[i]);
      }
    }

    var all = node.querySelectorAll ? node.querySelectorAll('*') : [];
    for (var j = 0; j < all.length; j++) {
      if (all[j].shadowRoot) {
        findAllInShadows(all[j].shadowRoot, selector, results);
      }
    }

    return results;
  }

  function getDeepActiveElement(doc) {
    var active = (doc || document).activeElement;
    while (active && active.shadowRoot && active.shadowRoot.activeElement) {
      active = active.shadowRoot.activeElement;
    }
    return active;
  }

  function elementMatchesOrContains(el, target) {
    if (!el || !target) return false;
    return el === target || el.contains(target);
  }

  function getNextOutsideTarget() {
    var dropdowns = findAllInShadows(document, 'drop-down.dropdown-header');
    return dropdowns.length ? dropdowns[0] : null;
  }

  function getLivereModal() {
    return document.querySelector('livere-web-modal');
  }

  function getModalRefs() {
    var modal = getLivereModal();
    if (!modal || !modal.shadowRoot) return null;

    var root = modal.shadowRoot;
    var content = root.querySelector('#content');
    var closeBtn = root.querySelector('.btn-close');

    var seoul = findAllInShadows(root, 'button-element.custom.btn-ghost')[0] || null;
    var kakao = findAllInShadows(root, 'button-element.kakao.btn-ghost')[0] || null;
    var naver = findAllInShadows(root, 'button-element.naver.btn-ghost')[0] || null;
    var twitter = findAllInShadows(root, 'button-element.twitter.btn-ghost')[0] || null;
    var google = findAllInShadows(root, 'button-element.google.btn-ghost')[0] || null;
    var facebook = findAllInShadows(root, 'button-element.facebook.btn-ghost')[0] || null;

    return {
      modal: modal,
      root: root,
      content: content,
      closeBtn: closeBtn,
      ordered: [seoul, kakao, naver, twitter, google, facebook, closeBtn].filter(Boolean)
    };
  }

  function isEditorTriggerTarget(target) {
    if (!target) return false;

    if (target.classList && target.classList.contains('overlay')) return true;
    if (target.tagName && target.tagName.toLowerCase() === 'text-box') return true;
    if (target.tagName && target.tagName.toLowerCase() === 'textarea' && target.id === 'textbox') return true;

    var root = target.getRootNode ? target.getRootNode() : null;
    if (root && root.host) {
      var hostTag = root.host.tagName ? root.host.tagName.toLowerCase() : '';
      if (hostTag === 'text-box') return true;
    }

    return false;
  }

  function bindKeyboardClick(el) {
    if (!el || el.hasAttribute('data-a11y-keyclick')) return;

    el.setAttribute('data-a11y-keyclick', 'true');
    if (!el.hasAttribute('tabindex')) {
      el.setAttribute('tabindex', '0');
    }

    el.addEventListener('keydown', function (e) {
      var key = e.key || e.code;
      if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
        e.preventDefault();
        if (typeof this.click === 'function') {
          this.click();
        }
      }
    });
  }

  function openModalByOverlayClick(overlayEl) {
    if (!overlayEl) return;
    window.__livereModalPendingTab = true;
    if (typeof overlayEl.click === 'function') {
      overlayEl.click();
    }
  }

  function patchLivereClose() {
    var refs = getModalRefs();
    if (!refs) return;

    var closeWrap = refs.closeBtn;
    var icon = refs.root.querySelector('.btn-close .icon');

    if (closeWrap && !closeWrap.hasAttribute('data-a11y-fixed')) {
      closeWrap.setAttribute('role', 'button');
      closeWrap.setAttribute('tabindex', '0');
      closeWrap.setAttribute('aria-label', '닫기');
      closeWrap.setAttribute('data-a11y-fixed', 'true');
    }

    bindKeyboardClick(closeWrap);

    if (icon) {
      icon.setAttribute('aria-label', '닫기');
    }

    if (icon && icon.shadowRoot) {
      var svg = icon.shadowRoot.querySelector('svg');
      if (svg) {
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('focusable', 'false');
      }
    }
  }

  function patchLivereSnsButtons() {
    var labelMap = {
      custom: '서울시 계정 로그인',
      kakao: '카카오 로그인',
      naver: '네이버 로그인',
      twitter: 'X(트위터) 로그인',
      google: '구글 로그인',
      facebook: '페이스북 로그인'
    };

    Object.keys(labelMap).forEach(function (key) {
      var buttons = findAllInShadows(document, 'button-element.' + key + '.btn-ghost');
      var label = labelMap[key];

      for (var i = 0; i < buttons.length; i++) {
        var btn = buttons[i];

        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', "새창열림");
        btn.setAttribute('tabindex', '0');

        bindKeyboardClick(btn);

        if (btn.shadowRoot) {
          var icon = btn.shadowRoot.querySelector('web-icon.icon');
          var img = btn.shadowRoot.querySelector('img.icon-image');

          var innerClickable = btn.shadowRoot.querySelector('button, [role="button"], .icon-container, .btn-ghost');
          if (innerClickable) {
            innerClickable.setAttribute('aria-label', label);
            bindKeyboardClick(innerClickable);
          }

          if (icon) {
            icon.setAttribute('aria-hidden', 'true');

            if (icon.shadowRoot) {
              var svg = icon.shadowRoot.querySelector('svg');
              if (svg) {
                svg.setAttribute('aria-hidden', 'true');
                svg.setAttribute('focusable', 'false');
              }
            }
          }

          if (img) {
            var imgAltMap = {
              custom: '서울시',
              kakao: '카카오',
              naver: '네이버',
              twitter: 'X(트위터)',
              google: '구글',
              facebook: '페이스북'
            };
            img.setAttribute('alt', imgAltMap[key] || '');
            img.setAttribute('aria-hidden', 'true');
          }
        }
      }
    });
  }

  function patchLivereEditorLabel() {
    var editors = findAllInShadows(document, 'text-editor');

    for (var i = 0; i < editors.length; i++) {
      var editor = editors[i];
      if (!editor.shadowRoot) continue;

      var textBox = editor.shadowRoot.querySelector('text-box#textbox');
      if (!textBox || !textBox.shadowRoot) continue;

      var textarea = textBox.shadowRoot.querySelector('textarea#textbox');
      if (!textarea) continue;

      textBox.setAttribute('aria-label', '댓글 입력');
      textBox.setAttribute('title', '댓글 입력');

      textarea.setAttribute('title', '댓글 내용 입력');
      textarea.setAttribute('aria-label', '댓글 내용 입력');
      textarea.setAttribute('placeholder', '댓글을 입력해주세요');
    }
  }

  function patchLivereEditorKeyboard() {
    var editors = findAllInShadows(document, 'text-editor');

    for (var i = 0; i < editors.length; i++) {
      var editor = editors[i];
      if (!editor.shadowRoot) continue;

      var overlay = editor.shadowRoot.querySelector('.overlay');
      var textBox = editor.shadowRoot.querySelector('text-box#textbox');
      var textarea = textBox && textBox.shadowRoot
        ? textBox.shadowRoot.querySelector('textarea#textbox')
        : null;

      if (overlay && !overlay.hasAttribute('data-a11y-fixed')) {
        overlay.setAttribute('role', 'button');
        overlay.setAttribute('tabindex', '0');
        overlay.setAttribute('aria-label', '로그인 창 열기');
        overlay.setAttribute('data-a11y-fixed', 'true');

        overlay.addEventListener('click', function () {
          window.__livereModalPendingTab = true;
        });

        overlay.addEventListener('keydown', function (e) {
          var key = e.key || e.code;
          if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
            e.preventDefault();
            openModalByOverlayClick(this);
          }
        });
      }

      if (textarea && !textarea.hasAttribute('data-a11y-fixed')) {
        textarea.setAttribute('data-a11y-fixed', 'true');

        textarea.addEventListener('keydown', function (e) {
          var key = e.key || e.code;
          if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
            var root = this.getRootNode();
            var host = root && root.host;
            var editorRoot = host && host.getRootNode ? host.getRootNode() : null;
            var editorHost = editorRoot && editorRoot.host;
            var overlayEl = editorHost && editorHost.shadowRoot
              ? editorHost.shadowRoot.querySelector('.overlay')
              : null;

            if (overlayEl) {
              e.preventDefault();
              openModalByOverlayClick(overlayEl);
            }
          }
        });
      }

      if (textBox && !textBox.hasAttribute('data-a11y-fixed')) {
        textBox.setAttribute('tabindex', '0');
        textBox.setAttribute('role', 'button');
        textBox.setAttribute('aria-label', '댓글 입력, 로그인 창 열기');
        textBox.setAttribute('data-a11y-fixed', 'true');

        textBox.addEventListener('keydown', function (e) {
          var key = e.key || e.code;
          if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
            var editorRoot = this.getRootNode();
            var editorHost = editorRoot && editorRoot.host;
            var overlayEl = editorHost && editorHost.shadowRoot
              ? editorHost.shadowRoot.querySelector('.overlay')
              : null;

            if (overlayEl) {
              e.preventDefault();
              openModalByOverlayClick(overlayEl);
            }
          }
        });
      }
    }
  }

  function patchLivereModalFocusFlow() {
    var refs = getModalRefs();
    if (!refs) return;

    var content = refs.content;
    var ordered = refs.ordered;
    var closeBtn = refs.closeBtn;

    if (content && !content.hasAttribute('data-a11y-modal-root')) {
      content.setAttribute('tabindex', '0');
      content.setAttribute('role', 'dialog');
      content.setAttribute('aria-modal', 'true');
      content.setAttribute('aria-label', '로그인 모달');
      content.setAttribute('data-a11y-modal-root', 'true');
    }

    for (var i = 0; i < ordered.length; i++) {
      if (!ordered[i].hasAttribute('tabindex')) {
        ordered[i].setAttribute('tabindex', '0');
      }
      bindKeyboardClick(ordered[i]);
    }

    if (closeBtn && !closeBtn.hasAttribute('data-a11y-close-enter')) {
      closeBtn.setAttribute('data-a11y-close-enter', 'true');

      closeBtn.addEventListener('keydown', function (e) {
        var key = e.key || e.code;
        if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
          e.preventDefault();

          var refsNow = getModalRefs();
          var nextOutside = getNextOutsideTarget();
          var icon = refsNow && refsNow.root
            ? refsNow.root.querySelector('.btn-close .icon')
            : null;

          if (icon && typeof icon.click === 'function') {
            icon.click();
          }

          setTimeout(function () {
            if (nextOutside) {
              nextOutside.setAttribute('tabindex', '0');
              nextOutside.focus();
            }
          }, 250);
        }
      });
    }
  }

  function handleGlobalTabFlow(e) {
    if (e.key !== 'Tab') return;

    var refs = getModalRefs();
    if (!refs) return;

    var active = getDeepActiveElement(document);
    var content = refs.content;
    var ordered = refs.ordered;
    var closeBtn = refs.closeBtn;
    var nextOutside = getNextOutsideTarget();

    if (window.__livereModalPendingTab && !e.shiftKey) {
      if (isEditorTriggerTarget(active) || !elementMatchesOrContains(refs.modal, active)) {
        e.preventDefault();
        window.__livereModalPendingTab = false;
        if (content) content.focus();
        return;
      }
    }

    if (active === content && !e.shiftKey) {
      e.preventDefault();
      if (ordered[0]) ordered[0].focus();
      return;
    }

    for (var i = 0; i < ordered.length; i++) {
      if (active === ordered[i]) {
        if (!e.shiftKey) {
          e.preventDefault();

          if (i < ordered.length - 1) {
            ordered[i + 1].focus();
          } else if (nextOutside) {
            nextOutside.setAttribute('tabindex', '0');
            nextOutside.focus();
          }
        }
        return;
      }
    }

    if (active === closeBtn && !e.shiftKey) {
      e.preventDefault();
      if (nextOutside) {
        nextOutside.setAttribute('tabindex', '0');
        nextOutside.focus();
      }
    }
  }

  function bindGlobalLivereTabFlow() {
    if (document.documentElement.hasAttribute('data-livere-global-tab-flow')) return;
    document.documentElement.setAttribute('data-livere-global-tab-flow', 'true');

    document.addEventListener('keydown', handleGlobalTabFlow, true);
  }

  function isDropdownMenuOpen(list) {
    if (!list) return false;
    var cs = window.getComputedStyle(list);
    return cs.display !== 'none'
      && cs.visibility !== 'hidden'
      && parseFloat(cs.opacity || '1') > 0;
  }

  function patchLivereSortSelected() {
    var dropdowns = findAllInShadows(document, 'drop-down.dropdown-header');

    for (var i = 0; i < dropdowns.length; i++) {
      var dropdown = dropdowns[i];
      if (!dropdown.shadowRoot) continue;

      var menuHost = dropdown.shadowRoot.querySelector('dropdown-menu');
      var triggerBtn = dropdown.querySelector('button-element.btn-text');

      if (menuHost && menuHost.shadowRoot) {
        var list = menuHost.shadowRoot.querySelector('#menu');
        var items = menuHost.shadowRoot.querySelectorAll('li.menu-item');

        // 현재 메뉴 열림 상태를 computed style로 판단
        var isMenuOpen = isDropdownMenuOpen(list);

        if (list) {
          list.setAttribute('role', 'listbox');
          list.setAttribute('aria-label', '댓글 정렬 선택');
        }

        for (var j = 0; j < items.length; j++) {
          var item = items[j];
          var textEl = item.querySelector('.truncate');
          var text = textEl ? textEl.textContent.trim() : item.textContent.trim();
          var isSelected = item.classList.contains('selected');

          item.setAttribute('role', 'option');
          item.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          item.setAttribute('aria-label', isSelected ? text + ' 선택됨' : text);
          item.setAttribute('title', isSelected ? text + ' 선택됨' : text);

          var checkIcon = item.querySelector('web-icon.icon');
          if (checkIcon) {
            checkIcon.setAttribute('aria-hidden', 'true');
            if (checkIcon.shadowRoot) {
              var svg = checkIcon.shadowRoot.querySelector('svg');
              if (svg) {
                svg.setAttribute('aria-hidden', 'true');
                svg.setAttribute('focusable', 'false');
              }
            }
          }

          bindKeyboardClick(item);
          // 메뉴가 열려있을 때만 탭 접근 허용, 닫혀있으면 탭 순서에서 제외
          item.setAttribute('tabindex', isMenuOpen ? '0' : '-1');
        }

        var selectedItem = menuHost.shadowRoot.querySelector('li.menu-item.selected');
        if (selectedItem && triggerBtn) {
          var selectedTextEl = selectedItem.querySelector('.truncate');
          var selectedText = selectedTextEl
            ? selectedTextEl.textContent.trim()
            : selectedItem.textContent.trim();

          triggerBtn.setAttribute('aria-label', selectedText + ' 선택됨, 댓글 정렬 선택');
          triggerBtn.setAttribute('aria-expanded', isMenuOpen ? 'true' : 'false');
          triggerBtn.setAttribute('title', selectedText + ' 선택됨, 댓글 정렬 선택');
          triggerBtn.setAttribute('tabindex', '0');
          bindKeyboardClick(triggerBtn);

          // 트리거 클릭 시 300ms 인터벌 대기 없이 즉시 tabindex 갱신
          if (!triggerBtn.hasAttribute('data-a11y-menu-toggle')) {
            triggerBtn.setAttribute('data-a11y-menu-toggle', 'true');
            triggerBtn.addEventListener('click', function () {
              var btn = this;
              setTimeout(function () {
                var ddEl = btn.parentElement;
                while (ddEl && ddEl.tagName && ddEl.tagName.toLowerCase() !== 'drop-down') {
                  ddEl = ddEl.parentElement;
                }
                if (!ddEl || !ddEl.shadowRoot) return;
                var mHost = ddEl.shadowRoot.querySelector('dropdown-menu');
                if (!mHost || !mHost.shadowRoot) return;
                var mList = mHost.shadowRoot.querySelector('#menu');
                var mItems = mHost.shadowRoot.querySelectorAll('li.menu-item');
                var open = isDropdownMenuOpen(mList);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                for (var k = 0; k < mItems.length; k++) {
                  mItems[k].setAttribute('tabindex', open ? '0' : '-1');
                }
              }, 50);
            });
          }
        }
      }

      var arrowIcon = dropdown.querySelector('web-icon.icon-arrow');
      if (arrowIcon) {
        arrowIcon.setAttribute('aria-hidden', 'true');
        if (arrowIcon.shadowRoot) {
          var arrowSvg = arrowIcon.shadowRoot.querySelector('svg');
          if (arrowSvg) {
            arrowSvg.setAttribute('aria-hidden', 'true');
            arrowSvg.setAttribute('focusable', 'false');
          }
        }
      }
    }
  }

  function patchLivereExternalLinks() {
  var links = findAllInShadows(document, 'a[target="_blank"]');
  for (var i = 0; i < links.length; i++) {
    var link = links[i];
    if (link.hasAttribute('data-a11y-external')) continue;
    link.setAttribute('data-a11y-external', 'true');

    var text = link.textContent ? link.textContent.trim() : '';
    var rawTitle = link.getAttribute('title') || text || '외부 링크';
    var baseTitle = rawTitle.replace(/\s*\(?\s*새창열림\s*\)?\s*/g, '').trim();

    if (link.getAttribute('title') === null || link.getAttribute('title').indexOf('새창열림') === -1) {
      link.setAttribute('title', baseTitle + ' 새창열림');
    }
    link.setAttribute('aria-label', baseTitle + ' 새창열림');
  }
}


  function patchLivereToggleReply() {
    var toggleSpans = findAllInShadows(document, 'span.toggle-reply');

    for (var i = 0; i < toggleSpans.length; i++) {
      var span = toggleSpans[i];

      // 최초 1회 설정: 탭 접근 가능, role, keydown
      if (!span.hasAttribute('data-a11y-toggle-reply')) {
        span.setAttribute('data-a11y-toggle-reply', 'true');
        span.setAttribute('tabindex', '0');
        span.setAttribute('role', 'button');

        var textSpan = span.querySelector('span');
        var countText = textSpan
          ? textSpan.textContent.replace(/\s+/g, ' ').trim()
          : '답글';
        span.setAttribute('aria-label', countText + ' 펼치기/접기');

        span.addEventListener('keydown', function (e) {
          var key = e.key || e.code;
          if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
            e.preventDefault();
            if (typeof this.click === 'function') {
              this.click();
            }
          }
        });
      }

      // 매 호출마다 aria-expanded 상태 동기화
      var root = span.getRootNode ? span.getRootNode() : null;
      var replyList = root ? root.querySelector('comment-list.reply-list') : null;
      span.setAttribute('aria-expanded', replyList ? 'true' : 'false');
    }
  }

  function patchLivereDeletedAccount() {
    // 탈퇴 회원의 actions-btn: CSS는 pointer-events:none이지만 display:none으로 완전 숨김
    var actionsBtns = findAllInShadows(document, 'div.actions-btn.deleted-account');
    for (var i = 0; i < actionsBtns.length; i++) {
      actionsBtns[i].style.display = 'none';
    }
  }

  function patchLivereCommentOption() {
    var dropdowns = findAllInShadows(document, 'drop-down.comment-option');

    for (var i = 0; i < dropdowns.length; i++) {
      var dropdown = dropdowns[i];
      if (!dropdown.shadowRoot) continue;

      // 탈퇴 회원인 경우 접근성 패치 불필요 (patchLivereDeletedAccount가 숨김 처리)
      var actionsBtn = dropdown.parentElement;
      if (actionsBtn && actionsBtn.classList.contains('deleted-account')) continue;

      var menuHost = dropdown.shadowRoot.querySelector('dropdown-menu');
      var triggerBtn = dropdown.querySelector('button-element');

      if (menuHost && menuHost.shadowRoot) {
        var list = menuHost.shadowRoot.querySelector('#menu');
        var items = menuHost.shadowRoot.querySelectorAll('li.menu-item');

        var isMenuOpen = isDropdownMenuOpen(list);

        if (list) {
          list.setAttribute('role', 'menu');
          list.setAttribute('aria-label', '댓글 옵션');
        }

        for (var j = 0; j < items.length; j++) {
          var item = items[j];
          var textEl = item.querySelector('.truncate');
          var text = textEl ? textEl.textContent.trim() : item.textContent.trim();

          item.setAttribute('role', 'menuitem');
          item.setAttribute('aria-label', text);
          item.setAttribute('title', text);

          var checkIcon = item.querySelector('web-icon.icon');
          if (checkIcon) {
            checkIcon.setAttribute('aria-hidden', 'true');
            if (checkIcon.shadowRoot) {
              var svg = checkIcon.shadowRoot.querySelector('svg');
              if (svg) {
                svg.setAttribute('aria-hidden', 'true');
                svg.setAttribute('focusable', 'false');
              }
            }
          }

          bindKeyboardClick(item);
          // 메뉴가 열려있을 때만 탭 접근 허용
          item.setAttribute('tabindex', isMenuOpen ? '0' : '-1');
        }

        if (triggerBtn) {
          // 최초 1회 설정
          if (!triggerBtn.hasAttribute('data-a11y-comment-option')) {
            triggerBtn.setAttribute('data-a11y-comment-option', 'true');
            triggerBtn.setAttribute('aria-label', '댓글 옵션 열기');
            triggerBtn.setAttribute('aria-haspopup', 'menu');
            triggerBtn.setAttribute('tabindex', '0');
            bindKeyboardClick(triggerBtn);

            // 클릭 시 즉시 tabindex·aria-expanded 갱신
            triggerBtn.addEventListener('click', function () {
              var btn = this;
              setTimeout(function () {
                var ddEl = btn.parentElement;
                while (ddEl && ddEl.tagName && ddEl.tagName.toLowerCase() !== 'drop-down') {
                  ddEl = ddEl.parentElement;
                }
                if (!ddEl || !ddEl.shadowRoot) return;
                var mHost = ddEl.shadowRoot.querySelector('dropdown-menu');
                if (!mHost || !mHost.shadowRoot) return;
                var mList = mHost.shadowRoot.querySelector('#menu');
                var mItems = mHost.shadowRoot.querySelectorAll('li.menu-item');
                var open = isDropdownMenuOpen(mList);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                for (var k = 0; k < mItems.length; k++) {
                  mItems[k].setAttribute('tabindex', open ? '0' : '-1');
                }
              }, 50);
            });
          }

          // 매 호출마다 aria-expanded 동기화
          triggerBtn.setAttribute('aria-expanded', isMenuOpen ? 'true' : 'false');
        }
      }

      // 트리거 내부 아이콘 숨김
      var innerIcon = dropdown.querySelector('web-icon');
      if (innerIcon) {
        innerIcon.setAttribute('aria-hidden', 'true');
      }
    }
  }

  function runLivereA11y() {
	patchLivereClose();
	patchLivereSnsButtons();
	patchLivereEditorLabel();
	patchLivereEditorKeyboard();
	patchLivereModalFocusFlow();
	patchLivereSortSelected();
  patchLivereExternalLinks();
  patchLivereToggleReply();
  patchLivereDeletedAccount();
  patchLivereCommentOption();
	bindGlobalLivereTabFlow();
  }

  runLivereA11y();
  setInterval(runLivereA11y, 300);
});
</script>
	</body>
</html>