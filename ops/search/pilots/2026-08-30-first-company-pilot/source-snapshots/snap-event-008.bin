.seoul.go.kr/www/contents/880.do?mid=636" title="서울시 웹접근성 품질인증">                            <img src="/resources/zeroCMS/site/main/images/web_accessibility_mark.png" alt="과학기술정보통신부 WEB ACCESSIBILITY 마크(웹 접근성 품질인증 마크)" class="mark">                        </a>                    </div>                 </div>            </div>        </div>    </footer>    <script>        $(function(){            $(".family-loc").click(function() {                if($("#family-site option:selected").val() != "") {                    window.open($("#family-site option:selected").val());                } else {                    alert("관련기관을 선택해주세요.");                }            });                        $(".webpage-loc").click(function() {                if($("#in-webpage option:selected").val() != "") {                    window.open($("#in-webpage option:selected").val());                } else {                    alert("개별누리집을 선택해주세요.");                }            });        })    </script>
		
