<script src="https://t1.kakaocdn.net/kakao_js_sdk/2.0.1/kakao.min.js"
  integrity="sha384-eKjgHJ9+vwU/FCSUG3nV1RKFolUXLsc6nLQ2R1tD0t4YFPCvRmkcF8saIfOZNWf/" crossorigin="anonymous"></script>
<script>
const shareUrl = encodeURI(window.location.href); // 전달할 URL
var sendText = $("#shareText").val();
	
function shareTwitter() {
	var sendText = $("#shareText").val(); // 전달할 텍스트
	var sendUrl = encodeURIComponent(shareUrl);
	console.log("sendText : " + sendText);
	console.log("shareUrl : " + shareUrl)
	console.log("sendUrl : " + sendUrl)
    window.open("https://twitter.com/intent/tweet?text=" + sendText + "&url=" + sendUrl);
}
function shareFacebook() {
	var sendUrl = encodeURIComponent(shareUrl);
    window.open("http://www.facebook.com/sharer/sharer.php?u=" + sendUrl);
}
function shareNaverBlog() {
	var sendText = encodeURI($("#shareText").val()); // 전달할 텍스트
	var sendUrl = encodeURI(encodeURIComponent(shareUrl)); // 네이버의 경우 로컬서버 주소는 인식하지못해 로컬시 사용안함
	//var sendUrl = encodeURI(encodeURIComponent("http://zero.wellpage.co.kr/apage/main.do"));
	console.log("sendText : " + sendText);
	console.log("shareUrl : " + shareUrl)
	console.log("sendUrl : " + sendUrl)
	window.open("https://share.naver.com/web/shareView?url=" + sendUrl + "&title=" + sendText);
    //window.open("http://blog.naver.com/openapi/share?url=" + sendUrl + "&title=" + sendText);
    
}

Kakao.init('5f16d5a47ed99ebf2466ab99a55446a6'); // 사용하려는 앱의 JavaScript 키 입력
function shareMessage() {
	var ogTtl = $('meta[property="og:title"]' ). attr( 'content' );
	var ogDesc = $('meta[property="og:description"]' ). attr( 'content' );
	var ogImg = $('meta[property="og:image"]' ). attr( 'content' );
	
    Kakao.Share.sendDefault({
      objectType: 'feed',
      content :{
    	  title: ogTtl,
    	  description: ogDesc,
   	      imageUrl: ogImg,
	      link: {
		      mobileWebUrl: shareUrl,
		      webUrl: shareUrl,
	      },
      },
    });
    console.log("shareUrl : " + shareUrl)
 }
  
function shareStoryWeb() {
	//var sendUrl = "http://zero.wellpage.co.kr/apage/main.do";
	//var sendUrl = encodeURI(encodeURIComponent(shareUrl)); // 네이버의 경우 로컬서버 주소는 인식하지못해 로컬시 사용안함
    Kakao.Story.share({
      url: shareUrl,  // 카카오 스토리의 경우 로컬서버 주소는 인식하지못해 공유 불가능
      //url: sendUrl,
      text: $("#shareText").val(),
    });
  }
function clip(){
	var textarea = document.createElement("textarea");
	document.body.appendChild(textarea);
	textarea.value = shareUrl;
	textarea.select();
	document.execCommand("copy");
	document.body.removeChild(textarea);
	alert("URL이 복사되었습니다.")
}  
</script>

<div class="sns-list">
