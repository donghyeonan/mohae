<script>
$(document).ready(function(){
	const mobile_mid = '538';
	if(mobile_mid != '' && mobile_mid != '0'){
		$('.m-gnb .wrap li.depth1-item, .m-gnb .wrap li.depth2-item .m-gnb .wrap li.depth3-item').removeClass('on');

		const activeTag = $('.m-gnb .wrap').find('a[data-mobile-mid='+mobile_mid+']');
		activeTag.closest('li.depth3-item').addClass('on');
		activeTag.closest('li.depth2-item').addClass('on');
		activeTag.closest('li.depth1-item').addClass('on');
	} else {
		$('.m-gnb .wrap > ul > li:nth-child(1)').addClass('on');
	}
	
	if(!($('.m-gnb .wrap li.depth1-item.on').length > 0)){
		$('.m-gnb .wrap > ul > li:nth-child(1)').addClass('on');
	}
	
})
</script>

		
