<script>

$(document).ready(function(){

	/** 카카오지도 불러오기*/
	document.querySelectorAll('a.kakao-location').forEach((tag) => tag.addEventListener('click', () => {
		let url = 'https://map.kakao.com/link/to/'
		let lat = tag.dataset.lat;
		let lot = tag.dataset.lot;
		let juso = tag.dataset.pstn;
		let geocoder = new kakao.maps.services.Geocoder();
		let coord = new kakao.maps.LatLng(lat, lot);
		let callback = function (result, status) {
			if (status === kakao.maps.services.Status.OK) {
				//juso = result[0].address.address_name
				url = url + juso + ',' + lat + ',' + lot
				window.open(encodeURI(url), '_blank');
			}
		};
		geocoder.coord2Address(coord.getLng(), coord.getLat(), callback);

	}))

	/** 네이버지도 불러오기*/
	document.querySelectorAll('a.naver-location').forEach((tag) => tag.addEventListener('click', () => {
		let url = 'http://map.naver.com/index.nhn?slng=&slat=&stext=&elng='
		let lat = tag.dataset.lat;
		let lot = tag.dataset.lot;
		let juso = tag.dataset.text;

		url = url + lot + "&elat=" + lat + "&etext=" + juso + "&menu=route&pathType=1";
		window.open(encodeURI(url), '_blank');

	}))
});


function goList() {
	$("#frm").attr("action", $("#srchType").val() == "calender" ? "calender.do" : "list.do");
	$("#frm").submit();
}
</script>
