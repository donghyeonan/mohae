		<li><a href="javascript:shareFacebook();" class="facebook" title="새창열림" aria-label="페이스북 공유하기">페이스북</a></li>

		<li><a href="javascript:shareMessage()" class="kakao-t" title="새창열림" id="kakaotalk-sharing-btn" aria-label="카카오톡 공유하기">카카오톡</a></li>
		<li><a href="javascript:shareNaverBlog();" class="blog" title="새창열림" aria-label="네이버 블로그 공유하기">블로그</a></li>
		<!-- <li><a href="" class="email" target="_blank" title="새창열림">이메일</a></li> -->
		<li><a href="javascript:clip()" class="address" aria-label="URL 주소 복사하기">주소복사</a></li>
	</ul>
</div>

