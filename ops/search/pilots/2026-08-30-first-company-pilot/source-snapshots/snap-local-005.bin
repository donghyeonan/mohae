<form name="f" id="f" method="post">

<input type="hidden" name="strConfirmYN" id="strConfirmYN" value="N">
<input type="hidden" name="gftCpnMstSeq" id="gftCpnMstSeq" value="3489">
<input type="hidden" name="strName" id="strName" value="이마트 경산점">
<input type="hidden" name="strName1" id="strName1" value="이마트 성서점">
<input type="hidden" name="strName2" id="strName2" value="이마트 월배점">

</form>

<script type="text/javascript">
    emart.Env.set('favorUrl', '/branch/regularEmart.do');
    emart.Env.set('bookmarkUrl', '/branch/bookmarkEmart.do');
    emart.Env.set('storePosition', {
        storeId: '1059',
        title: '스타필드마켓 월계점',
        x: '37.6261149',
        y: '127.0621375'
    });
    
    $( document ).ready(function() {
		
		
        // 즐겨찾기  설정
        $('#d-btn-bookmark').on('click', function(e) {
            var HTTP_URI = document.location.protocol+"//"+document.location.host;
            if(!window.isLogin) {
            	e.preventDefault();
                if(confirm('즐겨찾기를 설정하시려면 로그인이 필요합니다.\n로그인 화면으로 이동하시겠습니까?')){
                    if(window.isApp){
                        emart.app.cmd('open_main_webpage', 'link='+HTTP_URI+'/login/login.do?retUrl=/branch/view.do?id=1059');
                    } else {
                        location.href = '/login/login.do?retUrl=/branch/view.do?id=1059';
                    }
                }
                return;
            }
           
            var $el = $(this),
                storeId = $el.attr('data-store-id'),
                isBookmark = $el.is(":checked") ? 'Y' : 'N';

            $.ajax({
                url: emart.Env.get('bookmarkUrl'),
                data: {
                    storeId: storeId,
                    isBookmark: isBookmark
                },
                async: false,
                dataType: 'json'
            }).done(function(json) {
                if( 'string' == typeof(json) ){
                    json = JSON.parse(json);
                }

                if(json.success === true) {
                    if(window.isApp) {
                        emart.app.cmd('prev_page_reload', 'page_gb=3&op_time=1');
                    }
                } else {
                    alert(json.errMsg);
                }
            }).fail(function(){
                alert("즐겨찾기 설정에 실패 하였습니다.");
            });
        });
        
        // 단골점포 설정
        $('#d-btn-favor').on('click', function(e) {
            var HTTP_URI = document.location.protocol+"//"+document.location.host;
            if(!window.isLogin) {
            	e.preventDefault();
                if(confirm('단골점포를 설정하시려면 로그인이 필요합니다.\n로그인 화면으로 이동하시겠습니까?')){
                    if(window.isApp){
                        emart.app.cmd('open_main_webpage', 'link='+HTTP_URI+'/login/login.do?retUrl=/branch/view.do?id=1059');
                    } else {
                        location.href = '/login/login.do?retUrl=/branch/view.do?id=1059';
                    }
                }
                return;
            }
           
            var $el = $(this),
                storeId = $el.attr('data-store-id'),
                storeName = $el.attr('data-store-name'),
                storeType = $el.attr('data-store-type');

           if(!$el.is(":checked")){
               e.preventDefault();
               alert( "단골점포 설정을 취소하시려면\n 다른 점포를 단골점포로 설정해 주세요.");
               $el.prop("checked", "checked");
               return false;
           }
            
           var confirmStr = ''+storeName+'을 단골점포로 설정하시겠습니까?';
            if(!confirm(confirmStr)) {
            	e.preventDefault();
                return;
            }

            $.ajax({
                url: emart.Env.get('favorUrl'),
                data: {
                    storeId: storeId,
                    storeType: storeType
                },
                async: false,
                dataType: 'json'
            }).done(function(json) {
                if( 'string' == typeof(json)){
                    json = JSON.parse(json);
                }
                if(json.success === true) {
                	
                	storeName = $.trim(storeName);
                	
                	//alert("success");
                    emart.PubSub.trigger("change_favo_emart", {
                         "id": storeId,
                         "title": json.isfavor ? storeName : '단골이마트'
                    });
                    
                    if(window.isApp) {
                    	emart.app.cmd("open_menu_webpage", "link="+emart.Env.get("menuUrl")+"&storeId="+storeId);
                    	setTimeout(function() {
                    		emart.app.cmd('prev_page_reload', 'page_gb=3&op_time=1');
                   		}, 500);
                    }
                    
                    if(storeType == "T") {
                      checkTradersCouponAlert(json.tradersCouponResult);
                    }

                    if (storeType != "T" && $("#strConfirmYN").val() =="Y" && $("#strName").val() == storeName ) {
                    	fnGiftCpnInsert(storeName);
                    }
                    
                } else {
                    alert(json.errMsg);
                }
            }).fail(function(){
                alert("단골점포 설정에 실패 하였습니다.");
            });
        });

        fn_checkFavoriteJijum();
    });
    
    function moveCenter() {
        var regUrl = "https://m.cultureclub.emart.com/";
        if(window.isApp){
            emart.app.cmd("open_out_webpage", "link=" + regUrl);
        }else{
            window.open(regUrl);
        }

        return false; // href 동작 막기
    }
    
    function tabChange(obj) {
        event.preventDefault();
        $(".tab_contents").hide();
        $($(obj).attr("href")).show();
        $(".ern-tab a").attr("aria-selected", "false").parent().removeClass("on");
        $($(obj)).attr("aria-selected", "true").parent().addClass("on")
    }
    
    function fnGiftCpnInsert(strName) {
        
        var params = $.extend({}, doAjax_params_default);
        params['url'] = '/coupon/giftAppcpn_insert.do';
        params['data'] = {
           ticketMstSeq: $("#gftCpnMstSeq").val(),
           eventCode:"SE"
        };
        params['beforeSendCallbackFunction'] = function() {
            //console.log('beforeSendCallbackFunction');
        };
        params['successCallbackFunction'] = function(data){
           console.log(data);
            var jsonData= emart.isString(data) ? $.parseJSON(data) : data;
                if(jsonData.status =="1") {
                    if(!emart.util.loginCheck()) return;
                    return false;
                }else if(jsonData.status =="6") {
                    if(confirm(strName + " 단골점포 설정 및 증정품교환권이 지급되었습니다.\n쿠폰함으로 이동하시겠습니까?")){
                        
                        fnGftCpnListGo();
                    }else {
                        setTimeout(function() {
                            location.reload();
                        }, 500);
                        return false;
                    }
                }
        };
        params['completeCallbackFunction'] = function() {
            //console.log('completeCallbackFunction');
        };
        params['errorCallbackFunction'] = function(data){
            alert('오류가 발생했습니다.\r\n잠시후 다시 이용해 주세요.');
        };
        doAjax(params);
            
    }
    

    
    function fnGftCpnListGo() {
        var HTTP_URI = document.location.protocol+"//"+document.location.host;
        if(window.isApp){
            emart.app.cmd('open_main_webpage', 'link='+HTTP_URI+'/coupon/list.do?eventGbn=E&cpnGbn=C&tmstmp=1788070480000');
        } else {
            location.href = '/coupon/list.do?eventGbn=E&cpnGbn=C&tmstmp=1788070480000';
        }
    }

    //지점위치값 가져옴
    var storePositionX = ('37.6261149');
    var storePositionY = ('127.0621375');
    
    //V3옵션나열
    var mapOptions = {
        center: new naver.maps.LatLng(storePositionX, storePositionY),
        zoom : 17,
        enableWheelZoom : true,
        enableDragPan : true,
        enableDblClickZoom : false,
        mapMode : 0,
        minMaxLevel : [ 1, 20 ],
        zoomControl: true,
        zoomControlOptions: {
            position: naver.maps.Position.TOP_LEFT
        },
        useStyleMap: true
    };
    
    //맵옵션 불러옴
    var map = new naver.maps.Map('map', mapOptions);

    //위치마크표시
    var marker = new naver.maps.Marker({
        position: new naver.maps.LatLng(storePositionX, storePositionY),
        map: map
    });
    
    function moveMap() {
        var regUrl = "https://m.map.naver.com/viewer/map.naver?pinType=site&x=" + storePositionY + "&y=" + storePositionX;
        if(window.isApp){
            emart.app.cmd("open_out_webpage", "link=" + regUrl);
        }else{
            window.open(regUrl);
        }
    }
    
    
    function isBaseDt() {
    	var torf = false;
    		
    	var date = new Date();
    	var baseDay = date.getFullYear() + ("0"+ (date.getMonth()+1)).slice(-2)+("0"+date.getDate()).slice(-2);
    	if(Number(baseDay) >= 20210628) {
    		torf = true;
    	}
    	return torf;
    }

    function checkTradersCouponAlert(result) {
      const tradersCouponStatus = tradersCouponStatusMap[result.status];
      if (tradersCouponStatus) {
        tradersCouponStatus(result.message);
      }
    }

    const tradersCouponStatusMap = {
      '1': () => {
        if (!emart.util.loginCheck()) return;	//로그인 여부 체크
      },
      '': () => {
        alert('쿠폰 발급 중 오류가 발생했습니다.\r\n잠시후 다시 이용해주세요.');
      },
      '6': () => {
        if(confirm("트레이더스 쿠폰이 발급되었습니다.\n쿠폰함으로 이동하시겠습니까?")) {
          fn_doCouponGo();
        }
      },
      '4': () => {
        if (confirm("이미 할인쿠폰이 발급되었습니다.\n쿠폰함으로 이동하시겠습니까?")){
          fn_doCouponGo();
        }
      },
      '7': () => {
        alert("발급 받을 수 있는 쿠폰이 없습니다.");
      },
      '8': (message) => {
        alert(message);
      },
      '9': (message) => {
        alert(message);
      }
    }
	
	//쿠폰 페이지 이동
	function fn_doCouponGo() {
        var HTTP_URI = document.location.protocol+"//"+document.location.host;
		if(window.isApp){
			emart.app.cmd('open_main_webpage', 'link='+HTTP_URI+'/coupon/list.do?eventGbn=T&cpnGbn=A');
		} else {
			window.open('/coupon/list.do?eventGbn=T&cpnGbn=A');
		}
	}

    window.addEventListener('DOMContentLoaded', () => {
        if(!window.isApp) {
            document.title = '스타필드마켓 월계점' +' < 점포 찾기 < 이마트';
        }
    });

    function fn_checkFavoriteJijum() {
        let favorJijumId = [];
        let params = $.extend({}, doAjax_params_default);
        params['url'] = '/myemart/getFavoriteJijumList.do';
        params['successCallbackFunction'] = function (data) {
            const jsonData = emart.isString(data) ? $.parseJSON(data) : data;

            if (typeof(jsonData.favoriteJijumList) !== 'undefined' && Object.keys(jsonData.favoriteJijumList).length > 0 && '1059' != '') {
                if (typeof(jsonData.favoriteJijumList.emart) !== 'undefined' && 'true' === 'true') favorJijumId.push(jsonData.favoriteJijumList.emart.id);
                if (typeof(jsonData.favoriteJijumList.traders) !== 'undefined' && 'false' === 'true') favorJijumId.push(jsonData.favoriteJijumList.traders.id);
                if (typeof(jsonData.favoriteJijumList.mollys) !== 'undefined' && 'false' === 'true') favorJijumId.push(jsonData.favoriteJijumList.mollys.id);
                if (favorJijumId.includes('1059')) $('#d-btn-favor').attr('checked','checked');
            }
        };
        doAjax(params);
    }
</script>
