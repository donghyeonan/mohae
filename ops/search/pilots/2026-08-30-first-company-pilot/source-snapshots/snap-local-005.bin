<script>
$(function(){
	// 안드로이드 4.4.2 이하일 경우 #rn_wrap 요소에 deprecated 클래스 추가
	if(isApp && isAndroid && isAndroidDeprecated){
		$('#rn_wrap, #rn_pop_wrap').addClass('deprecated');
	}

	// 2019-12-06 추가 - iOS앱 심사 대응을 위한 문구 삽입
	if(isIOS && $('.detail_area').length > 0){
		var message = '본 경품이벤트는 Apple과 관련이 없음을 알려드립니다.';

		// 이벤트용
		$('.detail_area:not(.ex-apple-notification)')
			.filter(function(){ return ($(this).text().indexOf('꼭 확인하세요!') != -1)})
			.filter(function(){ return ($(this).text().indexOf('경품') != -1)})
			.find('dd').append('<br>- ' + message);

		// 당첨자 발표용
		$('.detail_area')
			.filter(function(){ return ($(this).text().indexOf('경품') != -1)})
			.find('dt').filter(function(){ return ($(this).text().indexOf('참고해 주세요') != -1)})
			.next().append('※ ' + message).css('padding-bottom', '40px');
	}

	// renew
    if (isIOS && $('.event-description').length) {
        $('.event-description')
            .filter(function () {return ($(this).text().indexOf('경품') != -1)})
            .append('<li>본 경품이벤트는 Apple과 관련이 없음을 알려드립니다.</li>');
    }

    // Firebase Log Record
    if ('' !== '' &&  '' !== '') {
        var params = '{"event": "campaign", "parameters": {"cmpgId": "", "trgId": ""}}';
        recFirebaseEvents(params);
    }
});
</script>

