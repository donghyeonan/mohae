<script type="text/javascript">
$(document).ready(function() {
	generateBarcode();
});
//바코드 생성
function generateBarcode(){
    var value       = $("#barcode-no").val();
    var btype       = "code128";
    var renderer    = "bmp";
    var settings    = {
            output:renderer,
            barWidth    : "2",
            barHeight   : "56",
            moduleSize  : "1",
            fontSize    : 14
    };
    $("#ern-barcode").barcode(value, btype, settings);
}
/*
 * 2021 리뉴얼 / 2021.03.11 / IG.KIM 맘키즈 가입여부 확인 
 */
function isMomKidsYn() {
    $.ajax({
        type		: "post",
        url			: "/app/getEmoneyYnAndMomKidsYn.do",
        dataType	: "json",
        async		: true,
        success		: function(data) {
            if(data != null) {
                data.isMomKids == 'true' ? $("#momkidsIcon").show() : $("#momkidsIcon").hide();
                data.isEmoney == 'true' ? $("#emoneyIcon").show() : $("#emoneyIcon").hide();
            }
        },
        error		: function(data, status, xhr) {
        }
    });
}
</script>
</article>
