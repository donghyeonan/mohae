		<script>
        const cookieName = 'eCookies_MAIN_APP_DOWNLOAD';

		$(document).ready(function() {
			// 메인 앱다운로드 있고 없고를 체크해서 body에 class 부여
			if ($.cookie(cookieName)) {
				$(".ern-appdown-check").hide();
			} else {
				$(".ern-appdown-check").show();
			}

		    $('.top-banner-close').click(function() {
                $.ajax({
                    type      : 'get',
                    data      : {act:'app_banner_close'},
                    dataType  : 'json',
                    async     : true,
                    url       : '/common/dummy.do'
                });

                setTimeout(function(){
                    $(".ern-appdown-check").slideUp(350);
                    $.cookie(cookieName, "hide", { expires: 1, path: '/' });
                    return false;
                }, 500);
		    });
		});
		</script>
