{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohae.local/schemas/evidence-claim.schema.json",
  "title": "MOHAE Evidence Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "subject_id", "claim_type", "claim_text", "polarity", "source_url", "source_role", "source_snapshot_id", "observed_at", "confidence", "inference_level", "verification_status"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "claim_type": {"type": "string", "enum": ["identity", "operation", "availability", "price", "benefit", "recognition", "demand", "scarcity", "safety", "legality", "quality", "trend", "causal_explanation", "other"]},
    "subtype": {"type": ["string", "null"]},
    "claim_text": {"type": "string", "minLength": 1},
    "polarity": {"type": "string", "enum": ["positive", "negative", "neutral", "conflicting"]},
    "source_url": {"type": "string", "format": "uri"},
    "source_role": {"type": "string", "enum": ["official", "selection_body", "merchant", "organizer", "booking", "ticketing", "behavior", "editorial", "news", "community", "other"]},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "source_content_hash": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "inference_level": {"type": "string", "enum": ["direct", "associated", "supported_causal_hypothesis", "causal_confirmed"]},
    "verification_status": {"type": "string", "enum": ["unverified", "verified", "disputed", "superseded", "rejected"]},
    "supersedes_claim_id": {"type": ["string", "null"]},
    "beneficiary_scope": {"type": ["string", "null"], "enum": ["everyone", "valid_applicant", "first_come", "selected", "lottery", "winner", null]},
    "acquisition_condition": {"type": ["string", "null"]},
    "competing_explanations": {"type": "array", "items": {"type": "string"}},
    "conflict_notes": {"type": ["string", "null"]}
  }
}
