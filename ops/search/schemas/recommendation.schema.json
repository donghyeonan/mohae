{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohae.local/schemas/recommendation.schema.json",
  "title": "MOHAE Recommendation Reason",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendation_id", "batch_id", "subject_id", "trust_verdict_id", "evidence_version", "primary_reason_claim_id", "primary_reason_text", "generated_at", "live_state_checked_at", "recheck_after", "source_link"],
  "properties": {
    "recommendation_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "trust_verdict_id": {"type": "string", "minLength": 1},
    "evidence_version": {"type": "string", "minLength": 1},
    "primary_reason_claim_id": {"type": "string", "minLength": 1},
    "primary_reason_text": {"type": "string", "minLength": 1, "maxLength": 240},
    "why_now_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_context_id": {"type": ["string", "null"], "minLength": 1},
    "why_you_text": {"type": ["string", "null"], "maxLength": 240},
    "caveat_text": {"type": ["string", "null"], "maxLength": 240},
    "live_state": {"type": ["string", "null"], "enum": ["available", "limited", "sold_out", "closed", "unknown", null]},
    "generated_at": {"type": "string", "format": "date-time"},
    "live_state_checked_at": {"type": "string", "format": "date-time"},
    "recheck_after": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "source_link": {"type": "string", "format": "uri"}
  },
  "allOf": [
    {
      "if": {"required": ["why_you_text"], "properties": {"why_you_text": {"type": "string"}}},
      "then": {"required": ["decision_context_id"]}
    }
  ]
}
